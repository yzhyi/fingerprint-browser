@@ -1,4 +1,5 @@
 #include "./canvas.h"
+#include "../utils/random.h"
 #include "../utils/parse_json.h"
 
 namespace fingerprint {
@@ -20,7 +21,36 @@ bool Canvas::ParseJson(const absl::optional<base::Value> &json_value) {
         FindDouble(params_dict, "rect_y", m_rect_y);
         FindDouble(params_dict, "rect_width", m_rect_width);
         FindDouble(params_dict, "rect_height", m_rect_height);
-        FindBool(params_dict, "modify_data_url", m_modify_data_url_enable);
+        // FindBool(params_dict, "modify_font_color", m_modify_data_url_enable);
+        FindDouble(params_dict, "seed", m_seed);
+        if (const base::DictValue* modify_data_url_dict = FindDict(params_dict, "modify_data_url"); modify_data_url_dict) {
+          FindBool(modify_data_url_dict, "enabled", m_modify_data_url.m_enabled);
+          FindDouble(modify_data_url_dict, "noise_min", m_modify_data_url.m_noise_min);
+          FindDouble(modify_data_url_dict, "noise_max", m_modify_data_url.m_noise_max);
+          m_modify_data_url.m_extra_space_cnt = RandomInt(m_modify_data_url.m_noise_min,
+                                                          m_modify_data_url.m_noise_max,
+                                                          static_cast<uint64_t>(m_seed));
+        }
+        if (const base::DictValue* modify_font_color_dict = FindDict(params_dict, "modify_font_color"); modify_font_color_dict) {
+          FindBool(modify_font_color_dict, "enabled", m_modify_font_color.m_enabled);
+          FindDouble(modify_font_color_dict, "noise_min", m_modify_font_color.m_noise_min);
+          FindDouble(modify_font_color_dict, "noise_max", m_modify_font_color.m_noise_max);
+          FindDouble(modify_font_color_dict, "noise_level", m_modify_font_color.m_noise_level);
+          static Random rand(m_modify_font_color.m_noise_min, m_modify_font_color.m_noise_max, m_seed);
+          m_modify_font_color.m_red_noise = rand.NextDouble() * m_modify_font_color.m_noise_level;
+          m_modify_font_color.m_green_noise = rand.NextDouble() * m_modify_font_color.m_noise_level;
+          m_modify_font_color.m_blue_noise = rand.NextDouble() * m_modify_font_color.m_noise_level;
+          m_modify_font_color.m_alpha_noise = rand.NextDouble() * m_modify_font_color.m_noise_level;
+        }
+        if (const base::DictValue* modify_conic_weight_dict = FindDict(params_dict, "modify_conic_weight"); modify_conic_weight_dict) {
+          FindBool(modify_conic_weight_dict, "enabled", m_modify_conic_weight.m_enabled);
+          FindDouble(modify_conic_weight_dict, "noise_min", m_modify_conic_weight.m_noise_min);
+          FindDouble(modify_conic_weight_dict, "noise_max", m_modify_conic_weight.m_noise_max);
+          FindDouble(modify_conic_weight_dict, "noise_level", m_modify_conic_weight.m_noise_level);
+          m_modify_conic_weight.m_weight_noise = RandomDouble(m_modify_conic_weight.m_noise_min * m_modify_conic_weight.m_noise_level,
+                                                          m_modify_conic_weight.m_noise_max * m_modify_conic_weight.m_noise_level,
+                                                          static_cast<uint64_t>(m_seed));
+        }
       }
     }
     return true;
@@ -65,10 +95,44 @@ void Canvas::ModifyRectHeight(double &value) {
 }
 
 std::string Canvas::ModifyDataURL(std::string data_url) {
-  if (m_enabled && m_modify_data_url_enable) {
-    data_url = data_url + " ";
+  if (m_enabled && m_modify_data_url.m_enabled) {
+    data_url = data_url + std::string(m_modify_data_url.m_extra_space_cnt, ' ');
   }
   return data_url;
 }
 
+double Canvas::GetFontRedNoise() {
+  if (m_enabled && m_modify_font_color.m_enabled) {
+    return m_modify_font_color.m_red_noise;
+  }
+  return 0;
+}
+
+double Canvas::GetFontGreenNoise() {
+  if (m_enabled && m_modify_font_color.m_enabled) {
+    return m_modify_font_color.m_green_noise;
+  }
+  return 0;
+}
+
+double Canvas::GetFontBlueNoise() {
+  if (m_enabled && m_modify_font_color.m_enabled) {
+    return m_modify_font_color.m_blue_noise;
+  }
+  return 0;
+}
+
+double Canvas::GetFontAlphaNoise() {
+  if (m_enabled && m_modify_font_color.m_enabled) {
+    return m_modify_font_color.m_alpha_noise;
+  }
+  return 0;
+}
+
+void Canvas::ModifyConicWeight(float &w) {
+  if (m_enabled && m_modify_conic_weight.m_enabled) {
+    w += static_cast<float>(m_modify_conic_weight.m_weight_noise);
+  }
+}
+
 } // namespace fingerprint
