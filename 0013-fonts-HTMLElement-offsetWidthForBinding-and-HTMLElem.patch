diff --git a/a_tools/fingerprint/controller.cc b/a_tools/fingerprint/controller.cc
index c706d9146a5e3..ad7ff417e4014 100644
--- a/a_tools/fingerprint/controller.cc
+++ b/a_tools/fingerprint/controller.cc
@@ -10,6 +10,17 @@ namespace fingerprint {
 
 const char kYzhyi[] = "yzhyi";
 
+int Controller::RandomInt(int min, int max) {
+  if (min > max) {
+    LOG(ERROR) << "Invalid range: min (" << min << ") is greater than max (" << max << ")";
+  }
+  static std::mt19937_64 engine(
+    std::chrono::steady_clock::now().time_since_epoch().count()
+  );
+  std::uniform_int_distribution<int> distribution(min, max);
+  return distribution(engine);
+}
+
 Controller::Controller()
   : m_command_line(base::CommandLine::ForCurrentProcess()) {
   if (m_command_line->HasSwitch(kYzhyi)) {
@@ -18,6 +29,7 @@ Controller::Controller()
     m_json_value = base::JSONReader::Read(m_json_str);
     ParseJson();
     ParseWebGL();
+    ParseFonts();
   }
 }
 
@@ -125,7 +137,29 @@ bool Controller::ParseWebGL() {
     return true;
   }
   return false;
-
 }
 
+bool Controller::ParseFonts() {
+  base::DictValue* fonts_dict = m_json_value->GetDict().FindDict("fonts");
+  if (fonts_dict) {
+    std::optional<bool> fonts_enable = fonts_dict->FindBool("enable");
+    if (fonts_enable.has_value() && fonts_enable.value()) {
+      m_fonts_enable = fonts_enable.value();
+      base::DictValue* fonts_params_dict = fonts_dict->FindDict("params");
+      if (fonts_params_dict) {
+        std::optional<double> fonts_noise_min = fonts_params_dict->FindDouble("noise_min");
+        if (fonts_noise_min.has_value()) {
+          m_fonts_noise_min = fonts_noise_min.value();
+        }
+        std::optional<double> fonts_noise_max = fonts_params_dict->FindDouble("noise_max");
+        if (fonts_noise_max.has_value()) {
+          m_fonts_noise_max = fonts_noise_max.value();
+        }
+      }
+    }
+    return true;
+  }
+  return false;
 }
+
+} // namespace fingerprint
