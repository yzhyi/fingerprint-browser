diff --git a/a_tools/fingerprint/webgpu/webgpu.cc b/a_tools/fingerprint/webgpu/webgpu.cc
new file mode 100644
index 0000000000000..78faf0c9f0638
--- /dev/null
+++ b/a_tools/fingerprint/webgpu/webgpu.cc
@@ -0,0 +1,122 @@
+#include "webgpu.h"
+#include <optional>
+
+namespace fingerprint {
+
+WebGPU::WebGPU(absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+WebGPU::~WebGPU() = default;
+
+bool WebGPU::ParseJson(absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  base::DictValue* dict = json_value->GetDict().FindDict("webgpu");
+  if (dict) {
+    std::optional<bool> enabled = dict->FindBool("enabled");
+    if (enabled.has_value() && enabled.value()) {
+      m_enabled = enabled.value();
+      base::DictValue* params_dict = dict->FindDict("params");
+      if (params_dict) {
+        base::DictValue* params_info_dict = params_dict->FindDict("info");
+        if (params_info_dict) {
+          std::string* vendor = params_info_dict->FindString("vendor");
+          if (vendor) {
+            m_vendor = *vendor;
+          }
+          std::string* architecture = params_info_dict->FindString("architecture");
+          if (architecture) {
+            m_architecture = *architecture;
+          }
+          std::string* device = params_info_dict->FindString("device");
+          if (device) {
+            m_device = *device;
+          }
+          std::string* description = params_info_dict->FindString("description");
+          if (description) {
+            m_description = *description;
+          }
+          std::optional<bool> is_fallback_adapter = params_info_dict->FindBool("is_fallback_adapter");
+          if (is_fallback_adapter.has_value()) {
+            m_is_fallback_adapter_initialized = true;
+            m_is_fallback_adapter = is_fallback_adapter.value();
+          }
+        }
+        base::DictValue* params_limits_dict = params_dict->FindDict("limits");
+        if (params_limits_dict) {
+          for (auto it = params_limits_dict->begin(); it != params_limits_dict->end(); ++it) {
+            // std::cout << it->first << ": " << it->second << ' ' << it->second.type() << std::endl;
+            if (it->second.is_int()) {
+              m_limits[it->first] = it->second.GetInt();
+            }
+            else if (it->second.is_double()) {
+              m_limits[it->first] = it->second.GetDouble();
+            }
+          }
+        }
+        base::DictValue* params_features_dict = params_dict->FindDict("features");
+        if (params_features_dict) {
+          for (auto it = params_features_dict->begin(); it != params_features_dict->end(); ++it) {
+            // std::cout << it->first << ": " << it->second << ' ' << it->second.type() << std::endl;
+            m_features[it->first] = it->second.GetBool();
+          }
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+void WebGPU::ModifyVendor(String &vendor) {
+  if (m_enabled && !m_vendor.empty()) {
+    vendor = String(m_vendor);
+  }
+}
+
+void WebGPU::ModifyArchitecture(String &architecture) {
+  if (m_enabled && !m_architecture.empty()) {
+    architecture = String(m_architecture);
+  }
+}
+
+void WebGPU::ModifyDevice(String &device) {
+  if (m_enabled && !m_device.empty()) {
+    device = String(m_device);
+  }
+}
+
+void WebGPU::ModifyDescription(String &description) {
+  if (m_enabled && !m_description.empty()) {
+    description = String(m_description);
+  }
+}
+
+void WebGPU::ModifyIsFallbackAdapter(bool &is_fallback_adapter) {
+  if (m_enabled && m_is_fallback_adapter_initialized) {
+    is_fallback_adapter = m_is_fallback_adapter;
+  }
+}
+
+void WebGPU::ModifyLimits(String name, uint32_t &value) {
+  std::string key = name.Ascii();
+  if (m_limits.contains(key)) {
+    value = m_limits[key];
+  }
+}
+
+void WebGPU::ModifyLimits(String name, uint64_t &value) {
+  std::string key = name.Ascii();
+  if (m_limits.contains(key)) {
+    value = m_limits[key];
+  }
+}
+
+std::unordered_map<std::string, bool> WebGPU::GetFeatures() {
+  if (m_enabled) {
+    return m_features;
+  }
+  return {};
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/webgpu/webgpu.h b/a_tools/fingerprint/webgpu/webgpu.h
new file mode 100644
index 0000000000000..4bbb4281f877a
--- /dev/null
+++ b/a_tools/fingerprint/webgpu/webgpu.h
@@ -0,0 +1,49 @@
+# pragma once
+
+#include <string>
+#include <unordered_map>
+#include "base/values.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class WebGPU {
+  friend Controller;
+private:
+  WebGPU(absl::optional<base::Value> &json_value);
+  ~WebGPU();
+  WebGPU(const WebGPU&) = delete;
+  WebGPU& operator=(const WebGPU&) = delete;
+  
+public:
+  bool ParseJson(absl::optional<base::Value> &json_value);
+  bool Enabled() { return m_enabled; }
+
+  void ModifyVendor(String &vendor);
+  void ModifyArchitecture(String &architecture);
+  void ModifyDevice(String &device);
+  void ModifyDescription(String &description);
+  void ModifyIsFallbackAdapter(bool &is_fallback_adapter);
+  void ModifyLimits(String name, uint32_t &value);
+  void ModifyLimits(String name, uint64_t &value);
+  std::unordered_map<std::string, bool> GetFeatures();
+
+private:
+  bool m_enabled{false};
+  // info
+  std::string m_vendor;
+  std::string m_architecture;
+  std::string m_device;
+  std::string m_description;
+  bool m_is_fallback_adapter_initialized{false};
+  bool m_is_fallback_adapter{false};
+  // limits
+  std::unordered_map<std::string, uint64_t> m_limits;
+  // features
+  std::unordered_map<std::string, bool> m_features;
+};
+
+} // namespace fingerprint
