new file mode 100644
index 0000000000000..b03b60102f6b7
--- /dev/null
+++ b/a_tools/fingerprint/canvas/canvas.cc
@@ -0,0 +1,98 @@
+#include <iostream>
+#include "canvas.h"
+
+namespace fingerprint {
+
+Canvas::Canvas(absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Canvas::~Canvas() = default;
+
+bool Canvas::ParseJson(absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  base::DictValue* dict = json_value->GetDict().FindDict("canvas");
+  if (dict) {
+    std::optional<bool> enabled = dict->FindBool("enabled");
+    if (enabled.has_value() && enabled.value()) {
+      m_enabled = enabled.value();
+      base::DictValue* params_dict = dict->FindDict("params");
+      if (params_dict) {
+        std::optional<double> width = params_dict->FindDouble("width");
+        if (width.has_value()) {
+          m_width = width.value();
+        }
+        std::optional<double> height = params_dict->FindDouble("height");
+        if (height.has_value()) {
+          m_height = height.value();
+        }
+        std::optional<double> rect_x = params_dict->FindDouble("rect_x");
+        if (rect_x.has_value()) {
+          m_rect_x = rect_x.value();
+        }
+        std::optional<double> rect_y = params_dict->FindDouble("rect_y");
+        if (rect_y.has_value()) {
+          m_rect_y = rect_y.value();
+        }
+        std::optional<double> rect_width = params_dict->FindDouble("rect_width");
+        if (rect_width.has_value()) {
+          m_rect_width = rect_width.value();
+        }
+        std::optional<double> rect_height = params_dict->FindDouble("rect_height");
+        if (rect_height.has_value()) {
+          m_rect_height = rect_height.value();
+        }
+        std::optional<bool> modify_data_url_enable = params_dict->FindBool("modify_data_url");
+        if (modify_data_url_enable.has_value() && modify_data_url_enable.value()) {
+          m_modify_data_url_enable = modify_data_url_enable.value();
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+void Canvas::ModifyWidth(unsigned &value) {
+  if (m_enabled) {
+    value += static_cast<unsigned>(m_width);
+  }
+}
+
+void Canvas::ModifyHeight(unsigned &value) {
+  if (m_enabled) {
+    value += static_cast<unsigned>(m_height);
+  }
+}
+
+void Canvas::ModifyRectX(double &value) {
+  if (m_enabled) {
+    value += static_cast<double>(m_rect_x);
+  }
+}
+
+void Canvas::ModifyRectY(double &value) {
+  if (m_enabled) {
+    value += static_cast<double>(m_rect_y);
+  }
+}
+
+void Canvas::ModifyRectWidth(double &value) {
+  if (m_enabled) {
+    value += static_cast<double>(m_rect_width);
+  }
+}
+
+void Canvas::ModifyRectHeight(double &value) {
+  if (m_enabled) {
+    value += static_cast<double>(m_rect_height);
+  }
+}
+
+void Canvas::ModifyDataURL(String &data_url) {
+  if (m_enabled && m_modify_data_url_enable) {
+    data_url = data_url + String(" ");
+  }
+}
+
+} // namespace fingerprint
