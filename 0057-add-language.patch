   ]
   deps = [
     "//base/allocator/partition_allocator:raw_ptr",
diff --git a/a_tools/fingerprint/controller.cc b/a_tools/fingerprint/controller.cc
index 5f96af3f47648..03868fd1ca827 100644
--- a/a_tools/fingerprint/controller.cc
+++ b/a_tools/fingerprint/controller.cc
@@ -27,11 +27,13 @@ Controller::Controller()
     m_webaudio(m_json_value),
     m_navigator(m_json_value),
     m_do_not_track(m_json_value),
-    m_user_agent(m_json_value)
+    m_user_agent(m_json_value),
+    m_language(m_json_value)
 {
 
   if (!m_command_line.get()->HasSwitch("type")) {
     AppendUserAgentCommandLine();
+    AppendLanguageCommandLine();
   }
 }
 
@@ -61,6 +63,24 @@ void Controller::AppendUserAgentCommandLine() {
   }
 }
 
+void Controller::AppendLanguageCommandLine() {
+  if (m_language.Enabled()) {
+    if (!m_language.GetLanguage().empty()) {
+      const_cast<base::CommandLine*>(m_command_line.get())
+        ->AppendSwitchASCII(m_language.GetCommandLineKeyLang(), m_language.GetLanguage());
+    }
+    if (!m_language.GetLanguages().empty()) {
+      std::string languages;
+      for (auto &language : m_language.GetLanguages()) {
+        languages += language + ",";
+      }
+      languages.pop_back();
+      const_cast<base::CommandLine*>(m_command_line.get())
+        ->AppendSwitchASCII(m_language.GetCommandLineKeyAcceptLang(), languages);
+    }
+  }
+}
+
 void Controller::PrintJson() {
   std::cout << "Controller::PrintJson: " << m_json_str << std::endl;
   LOG(INFO) << "Controller::PrintJson: " << m_json_str;
