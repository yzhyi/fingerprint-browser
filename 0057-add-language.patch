diff --git a/a_tools/fingerprint/language/language.cc b/a_tools/fingerprint/language/language.cc
new file mode 100644
index 0000000000000..c61f6b4d711f7
--- /dev/null
+++ b/a_tools/fingerprint/language/language.cc
@@ -0,0 +1,47 @@
+#include "./language.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+Language::Language(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Language::~Language() = default;
+
+bool Language::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "language"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindString(params_dict, "language", m_language);
+        if (const base::ListValue* languages_dict = FindList(params_dict, "languages"); languages_dict) {
+          for (auto& language : *languages_dict) {
+            m_languages.push_back(language.GetString());
+          }
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+std::string Language::GetCommandLineKeyAcceptLang() {
+  return "accept-lang";
+}
+
+std::string Language::GetCommandLineKeyLang() {
+  return "lang";
+}
+
+std::string Language::GetLanguage() {
+  return m_language;
+}
+
+std::vector<std::string> Language::GetLanguages() {
+  return m_languages;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/language/language.h b/a_tools/fingerprint/language/language.h
new file mode 100644
index 0000000000000..e9ef0003c07a3
--- /dev/null
+++ b/a_tools/fingerprint/language/language.h
@@ -0,0 +1,24 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+FINGERPRINT_CLASS_DECLARE(Language);
+
+public:
+  std::string GetCommandLineKeyAcceptLang();
+  std::string GetCommandLineKeyLang();
+  std::string GetLanguage();
+  std::vector<std::string> GetLanguages();
+
+private:
+  std::string m_language;
+  std::vector<std::string> m_languages;
+
+FINGERPRINT_CLASS_END();
+
+} // namespace fingerprint
