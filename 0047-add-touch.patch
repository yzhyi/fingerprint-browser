 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#ifdef ENABLE_FINGERPRINT
+#include "a_tools/fingerprint/controller.h"
+#endif // ENABLE_FINGERPRINT
+
 #include "third_party/blink/renderer/core/css/media_values.h"
 
 #include "third_party/blink/public/common/css/scripting.h"
@@ -373,6 +377,13 @@ mojom::blink::PointerType MediaValues::CalculatePrimaryPointerType(
 int MediaValues::CalculateAvailablePointerTypes(LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto& touch = fingerprint::Controller::GetInstance().GetTouch(); touch.Enabled()) {
+    return touch.GetPointerTypes();
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return frame->GetSettings()->GetAvailablePointerTypes();
 }
 
