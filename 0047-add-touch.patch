diff --git a/a_tools/fingerprint/touch/touch.cc b/a_tools/fingerprint/touch/touch.cc
new file mode 100644
index 0000000000000..e22dc1d9fab7a
--- /dev/null
+++ b/a_tools/fingerprint/touch/touch.cc
@@ -0,0 +1,35 @@
+#include "./touch.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+#include "ui/base/pointer/pointer_device.h"
+
+namespace fingerprint {
+
+Touch::Touch(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Touch::~Touch() = default;
+
+bool Touch::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "touch"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindDouble(params_dict, "max_touch_points", m_max_touch_points);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+int32_t Touch::GetMaxTouchPoints() {
+  return static_cast<int32_t>(m_max_touch_points);
+}
+
+int Touch::GetPointerTypes() {
+  return ui::PointerType::POINTER_TYPE_COARSE;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/touch/touch.h b/a_tools/fingerprint/touch/touch.h
new file mode 100644
index 0000000000000..6febf998dae8a
--- /dev/null
+++ b/a_tools/fingerprint/touch/touch.h
@@ -0,0 +1,31 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class Touch : public BaseFingerprint {
+public:
+  friend Controller;
+  Touch(const Touch&) = delete;
+  Touch& operator=(const Touch&) = delete;
+
+private:
+  explicit Touch(const absl::optional<base::Value> &json_value);
+  ~Touch() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  BASE_EXPORT int32_t GetMaxTouchPoints();
+  BASE_EXPORT int GetPointerTypes();
+
+private:
+  double m_max_touch_points{0};
+};
+
+} // namespace fingerprint
