-// TODO: Yzhyi
-void WebRTC::ModifyAddress(webrtc::IceCandidateType type, webrtc::SocketAddress &address) {
+static std::string ExtractCandidateType(const std::string& candidate_str) {
+  // 查找 "typ " 关键字
+  size_t typ_pos = candidate_str.find(" typ ");
+  if (typ_pos == std::string::npos) {
+    return "";
+  }
+
+  // 跳过 " typ "
+  size_t type_start = typ_pos + 5;
+  if (type_start >= candidate_str.length()) {
+    return "";
+  }
+
+  // 查找类型结束位置（空格或字符串结尾）
+  size_t type_end = candidate_str.find(' ', type_start);
+  if (type_end == std::string::npos) {
+    type_end = candidate_str.length();
+  }
+
+  return candidate_str.substr(type_start, type_end - type_start);
+}
+
+static std::string ReplaceCandidateAddress(
+    const std::string &candidate_str,
+    const std::string &new_ip,
+    uint16_t new_port) {
+
+  // 候选者字符串格式: candidate:foundation component protocol priority ip port typ type [...]
+  // 我们需要替换第5和第6个字段（IP和端口）
+
+  std::istringstream iss(candidate_str);
+  std::vector<std::string> tokens;
+  std::string token;
+
+  // 分割字符串
+  while (iss >> token) {
+    tokens.push_back(token);
+  }
+
+  // 检查格式是否正确（至少需要7个字段）
+  if (tokens.size() < 7) {
+    return "";
+  }
+
+  // 替换 IP（第5个字段，索引4）和端口（第6个字段，索引5）
+  tokens[4] = new_ip;
+  tokens[5] = std::to_string(new_port);
+
+  // 重新组装字符串
+  std::ostringstream oss;
+  for (size_t i = 0; i < tokens.size(); ++i) {
+    if (i > 0) {
+      oss << " ";
+    }
+    oss << tokens[i];
+  }
+
+  return oss.str();
+}
+
+std::string WebRTC::ModifyCandidate(std::string candidate) {
   if (m_enabled) {
-    if (type == webrtc::IceCandidateType::kHost) {
-      address = webrtc::SocketAddress(m_host_ip, static_cast<int>(m_host_port));
+    std::string detected_type = ExtractCandidateType(candidate);
+    if (detected_type.empty()) {
+      return candidate;
     }
-    else if (type == webrtc::IceCandidateType::kSrflx) {
-      address = webrtc::SocketAddress(m_srflx_ip, static_cast<int>(m_srflx_port));
+    std::string ip;
+    uint16_t port{0};
+    if (detected_type == "host") {
+      ip = m_host_ip;
+      port = static_cast<uint16_t>(m_host_port);
+    } else if (detected_type == "srflx") {
+      ip = m_srflx_ip;
+      port = static_cast<uint16_t>(m_srflx_port);
+    } else if (detected_type == "relay") {
+      ip = m_relay_ip;
+      port = static_cast<uint16_t>(m_relay_port);
+    } else { // prflx
+      ip = m_srflx_ip;
+      port = static_cast<uint16_t>(m_srflx_port);
     }
-    else if (type == webrtc::IceCandidateType::kRelay) {
-      address = webrtc::SocketAddress(m_relay_ip, static_cast<int>(m_relay_port));
+    std::string modified_candidate = ReplaceCandidateAddress(candidate, ip, port);
+
+    if (!modified_candidate.empty()) {
+      candidate = modified_candidate;
     }
   }
+  return candidate;
 }
 
