diff --git a/a_tools/fingerprint/base_fingerprint.h b/a_tools/fingerprint/base_fingerprint.h
new file mode 100644
index 0000000000000..44ba79ef1f0a3
--- /dev/null
+++ b/a_tools/fingerprint/base_fingerprint.h
@@ -0,0 +1,26 @@
+# pragma once
+
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class BaseFingerprint {
+public:
+  friend Controller;
+  BaseFingerprint() = default;
+  BaseFingerprint(const BaseFingerprint&) = delete;
+  BaseFingerprint& operator=(const BaseFingerprint&) = delete;
+  virtual ~BaseFingerprint() = default;
+  
+public:
+  virtual bool ParseJson(const absl::optional<base::Value> &json_value) = 0;
+  bool Enabled() { return m_enabled; }
+
+protected:
+  bool m_enabled{false};
+};
+
+} // namespace fingerprint
