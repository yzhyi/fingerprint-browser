diff --git a/a_tools/fingerprint/webrtc/webrtc.cc b/a_tools/fingerprint/webrtc/webrtc.cc
new file mode 100644
index 0000000000000..cead9027f9870
--- /dev/null
+++ b/a_tools/fingerprint/webrtc/webrtc.cc
@@ -0,0 +1,24 @@
+#include "webrtc.h"
+#include "a_tools/fingerprint/utils/parse_json.h"
+
+namespace fingerprint {
+
+WebRTC::WebRTC(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+WebRTC::~WebRTC() = default;
+
+bool WebRTC::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "webrtc"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/webrtc/webrtc.h b/a_tools/fingerprint/webrtc/webrtc.h
new file mode 100644
index 0000000000000..409a051bac38c
--- /dev/null
+++ b/a_tools/fingerprint/webrtc/webrtc.h
@@ -0,0 +1,27 @@
+# pragma once
+
+#include "a_tools/fingerprint/base_fingerprint.h"
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class WebRTC : public BaseFingerprint {
+public:
+  friend Controller;
+  WebRTC(const WebRTC&) = delete;
+  WebRTC& operator=(const WebRTC&) = delete;
+
+private:
+  explicit WebRTC(const absl::optional<base::Value> &json_value);
+  ~WebRTC() override;
+  
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+
+private:
+};
+
+} // namespace fingerprint
