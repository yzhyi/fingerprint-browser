diff --git a/third_party/blink/renderer/core/html/html_element.cc b/third_party/blink/renderer/core/html/html_element.cc
index a763c60b6d505..4ff9fbaedd0a2 100644
--- a/third_party/blink/renderer/core/html/html_element.cc
+++ b/third_party/blink/renderer/core/html/html_element.cc
@@ -22,6 +22,14 @@
  * Boston, MA 02110-1301, USA.
  *
  */
+// Yzhyi start
+#include <random>
+#include "base/command_line.h"
+#include "third_party/blink/public/common/switches.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+// Yzhyi end
 
 #include "third_party/blink/renderer/core/html/html_element.h"
 
@@ -3009,6 +3017,19 @@ int HTMLElement::offsetTopForBinding() {
   return OffsetTopOrLeft(/*top=*/true);
 }
 
+// Yzhyi start
+int getRandomIntForFoo2Modern() {
+  static std::mt19937 generator(static_cast<unsigned long>(time(NULL))); // 静态以确保只初始化一次
+  std::uniform_int_distribution<int> distribution(0, 9);
+  int tmp = distribution(generator);
+  if (tmp > 0){
+    return 0;
+  }else{
+    return 1;
+  }
+}
+// Yzhyi end
+
 int HTMLElement::offsetWidthForBinding() {
   GetDocument().EnsurePaintLocationDataValidForNode(
       this, DocumentUpdateReason::kJavaScript);
@@ -3016,6 +3037,19 @@ int HTMLElement::offsetWidthForBinding() {
   if (const auto* layout_object = GetLayoutBoxModelObject()) {
     result = AdjustedOffsetForZoom(layout_object->OffsetWidth());
   }
+  // Yzhyi start
+  const ::base::CommandLine* yzhyi_command_line = ::base::CommandLine::ForCurrentProcess();
+  if (yzhyi_command_line->HasSwitch(switches::kYzhyi)) {
+    std::string yzhyi_command_str = yzhyi_command_line->
+      GetSwitchValueASCII(switches::kYzhyi);
+    absl::optional<base::Value> yzhyi_command_value =
+      base::JSONReader::Read(yzhyi_command_str);
+    std::optional<bool> data = yzhyi_command_value->GetDict().FindBool("fonts");
+    if (data.has_value() == true) {
+      result = result + getRandomIntForFoo2Modern();
+    }
+  }
+  // Yzhyi end
   return result;
 }
 
@@ -3027,6 +3061,19 @@ int HTMLElement::offsetHeightForBinding() {
   if (const auto* layout_object = GetLayoutBoxModelObject()) {
     result = AdjustedOffsetForZoom(layout_object->OffsetHeight());
   }
+  // Yzhyi start
+  const ::base::CommandLine* yzhyi_command_line = ::base::CommandLine::ForCurrentProcess();
+  if (yzhyi_command_line->HasSwitch(switches::kYzhyi)) {
+    std::string yzhyi_command_str = yzhyi_command_line->
+      GetSwitchValueASCII(switches::kYzhyi);
+    absl::optional<base::Value> yzhyi_command_value =
+      base::JSONReader::Read(yzhyi_command_str);
+    std::optional<bool> data = yzhyi_command_value->GetDict().FindBool("fonts");
+    if (data.has_value() == true) {
+      result = result + getRandomIntForFoo2Modern();
+    }
+  }
+  // Yzhyi end
   return result;
 }
 
