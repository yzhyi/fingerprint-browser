@@ -9,6 +13,13 @@
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+
+  // Yzhyi start
+  if (fingerprint::Controller::GetInstance().GetHardwareConcurrency().Enabled()) {
+    return fingerprint::Controller::GetInstance().GetHardwareConcurrency().ModifyHardwareConcurrency(static_cast<unsigned>(base::SysInfo::NumberOfProcessors()));
+  }
+  // Yzhyi end
+
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
