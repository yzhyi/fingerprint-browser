diff --git a/a_tools/fingerprint/hardware_concurrency/hardware_concurrency.cc b/a_tools/fingerprint/hardware_concurrency/hardware_concurrency.cc
new file mode 100644
index 0000000000000..0066ecce97169
--- /dev/null
+++ b/a_tools/fingerprint/hardware_concurrency/hardware_concurrency.cc
@@ -0,0 +1,35 @@
+#include "hardware_concurrency.h"
+#include "a_tools/fingerprint/utils/random.h"
+#include "a_tools/fingerprint/utils/parse_json.h"
+#include <cstdint>
+#include <iostream>
+
+namespace fingerprint {
+
+HardwareConcurrency::HardwareConcurrency(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+HardwareConcurrency::~HardwareConcurrency() = default;
+
+bool HardwareConcurrency::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "hardware_concurrency"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindDouble(params_dict, "cores", m_cores);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+unsigned HardwareConcurrency::ModifyHardwareConcurrency(unsigned cores) {
+  if (m_enabled) {
+    return m_cores;
+  }
+  return cores;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/hardware_concurrency/hardware_concurrency.h b/a_tools/fingerprint/hardware_concurrency/hardware_concurrency.h
new file mode 100644
index 0000000000000..b4f0c13f7a429
--- /dev/null
+++ b/a_tools/fingerprint/hardware_concurrency/hardware_concurrency.h
@@ -0,0 +1,29 @@
+# pragma once
+
+#include "a_tools/fingerprint/base_fingerprint.h"
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class HardwareConcurrency : public BaseFingerprint {
+public:
+  friend Controller;
+  HardwareConcurrency(const HardwareConcurrency&) = delete;
+  HardwareConcurrency& operator=(const HardwareConcurrency&) = delete;
+
+private:
+  explicit HardwareConcurrency(const absl::optional<base::Value> &json_value);
+  ~HardwareConcurrency() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  unsigned ModifyHardwareConcurrency(unsigned cores);
+
+private:
+  double m_cores{0};
+};
+
+} // namespace fingerprint
