diff --git a/a_tools/fingerprint/utils/numeric.cc b/a_tools/fingerprint/utils/numeric.cc
new file mode 100644
index 0000000000000..022d52413aa62
--- /dev/null
+++ b/a_tools/fingerprint/utils/numeric.cc
@@ -0,0 +1,11 @@
+#include "./numeric.h"
+#include <cmath>
+#include <limits>
+
+bool isZero(double value) {
+    if (std::isnan(value) || std::isinf(value)) {
+        return false;
+    }
+
+    return std::fabs(value) < 10 * std::numeric_limits<double>::epsilon();
+}
