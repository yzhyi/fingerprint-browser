index 0000000000000..1b2cff9582b67
--- /dev/null
+++ b/a_tools/fingerprint/battery/battery.cc
@@ -0,0 +1,66 @@
+#include "./battery.h"
+#include "../utils/parse_json.h"
+#include <iostream>
+
+namespace fingerprint {
+
+const int64_t MIN_TO_MICROSECOND = 60 * 1000 * 1000;
+
+Battery::Battery(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Battery::~Battery() = default;
+
+bool Battery::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "battery"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindDouble(params_dict, "level", m_level);
+        FindBool(params_dict, "charging", m_charging);
+        FindBool(params_dict, "enable_time", m_enable_time);
+        FindDouble(params_dict, "charging_time", m_charging_time);
+        FindDouble(params_dict, "discharging_time", m_discharging_time);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+void Battery::ModifyCharging(bool &charging) {
+  if (m_enabled) {
+    charging = m_charging;
+  }
+}
+
+void Battery::ModifyLevel(double &level) {
+  if (m_enabled) {
+    level = m_level;
+  }
+}
+
+int64_t Battery::ModifyChargingTime(int64_t charging_time) {
+  if (m_enabled && m_enable_time) {
+    charging_time = static_cast<int64_t>(m_charging_time * MIN_TO_MICROSECOND);
+    if (static_cast<int>(m_level) == 1) {   // 满电
+      charging_time = 0;
+    } else if (!m_charging) {
+      charging_time = std::numeric_limits<int64_t>::max(); // TODO: may be std::numeric_limits<int64_t>::min()
+    }
+  }
+  return charging_time;
+}
+
+int64_t Battery::ModifyDischargingTime(int64_t discharging_time) {
+  if (m_enabled && m_enable_time) {
+    discharging_time = static_cast<int64_t>(m_discharging_time * MIN_TO_MICROSECOND);
+    if (m_charging) {
+      discharging_time = std::numeric_limits<int64_t>::max();
+    }
+  }
+  return discharging_time;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/battery/battery.h b/a_tools/fingerprint/battery/battery.h
new file mode 100644
index 0000000000000..6e706192bcbf2
--- /dev/null
+++ b/a_tools/fingerprint/battery/battery.h
@@ -0,0 +1,38 @@
+# pragma once
+
+#include <cstdint>
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class Battery : public BaseFingerprint {
+public:
+  friend Controller;
+  Battery(const Battery&) = delete;
+  Battery& operator=(const Battery&) = delete;
+
+private:
+  explicit Battery(const absl::optional<base::Value> &json_value);
+  ~Battery() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  BASE_EXPORT void ModifyLevel(double &level);
+  BASE_EXPORT void ModifyCharging(bool &charging);
+  BASE_EXPORT int64_t ModifyChargingTime(int64_t charge_time); // 还要多久才能充满(单位: 分钟)
+  BASE_EXPORT int64_t ModifyDischargingTime(int64_t discharge_time); // 还能放电多久(单位: 分钟)
+
+private:
+  double m_level{0};
+  bool m_charging{false};
+  bool m_enable_time{false};
+  double m_charging_time{0};
+  double m_discharging_time{0};
+};
+
+} // namespace fingerprint
