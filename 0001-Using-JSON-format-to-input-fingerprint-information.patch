@@ -623,6 +632,26 @@ void CommandLine::ParseFromString(StringViewType command_line) {
 
 #endif  // BUILDFLAG(IS_WIN)
 
+// Yzhyi start
+bool isJsonFile(const std::string& filename) {
+    std::filesystem::path filePath(filename);
+    return filePath.extension() == ".json";
+}
+
+bool isValidJson(const std::string& jsonString) {
+    auto result =
+        base::JSONReader::ReadAndReturnValueWithError(jsonString);
+
+    if (!result.has_value()) {
+        LOG(INFO) << "JSON 解析错误: " << result.error().message
+                   << " 行: " << result.error().line
+                   << " 列: " << result.error().column;
+        return false;
+    }
+    return true;
+}
+// Yzhyi end
+
 void CommandLine::AppendSwitchesAndArguments(span<const StringType> argv) {
   bool parse_switches = true;
 #if BUILDFLAG(IS_WIN)
@@ -639,6 +668,20 @@ void CommandLine::AppendSwitchesAndArguments(span<const StringType> argv) {
     CommandLine::StringType switch_value;
     parse_switches &= (arg != kSwitchTerminator);
     if (parse_switches && IsSwitch(arg, &switch_string, &switch_value)) {
+      // Yzhyi start
+      const char kYzhyi[] = "--yzhyi";
+      if (switch_string == CommandLine::StringType(kYzhyi)) {
+      // if (switch_string == CommandLine::StringType("yzhyi")) {
+        if (isJsonFile(switch_value)) {
+          ::base::FilePath path(switch_value);
+          std::string temp_str;
+          ReadFileToString(path, &temp_str);
+          if (isValidJson(temp_str)) {
+            switch_value = temp_str;
+          }
+        }
+      }
+      // Yzhyi end
 #if BUILDFLAG(IS_WIN)
       if (is_parsed_from_string &&
           IsSwitchWithKey(switch_string, kSingleArgument)) {
diff --git a/base/json/json_reader_unittest.cc b/base/json/json_reader_unittest.cc
index ff5f258f28777..3d13ebab90add 100644
--- a/base/json/json_reader_unittest.cc
+++ b/base/json/json_reader_unittest.cc
@@ -52,6 +52,16 @@ base::HeapArray<char> MakeNotNullTerminatedInput(const char* input) {
 
 namespace base {
 
+TEST(JSONReaderTest, Yzhyi) {
+  std::optional<Value> root = JSONReader::Read("{\"name\": \"yzy\"}");
+  ASSERT_TRUE(root);
+  const Value::Dict* root_dict = root->GetIfDict();
+  ASSERT_TRUE(root_dict);
+  const std::string* str_val = root_dict->FindString("name");
+  ASSERT_TRUE(str_val);
+  EXPECT_EQ("yzy", *str_val);
+}
+
 TEST(JSONReaderTest, Whitespace) {
   std::optional<Value> root = JSONReader::Read("   null   ");
   ASSERT_TRUE(root);
