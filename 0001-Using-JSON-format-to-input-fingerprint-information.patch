 void RenderProcessHostImpl::AppendRendererCommandLine(
-    base::CommandLine* command_line) {
+    ::base::CommandLine* command_line) {
+  // Yzhyi start
+  const ::base::CommandLine* yzhyi_command_line = ::base::CommandLine::ForCurrentProcess();
+  if (yzhyi_command_line->HasSwitch(switches::kYzhyi)) {
+    std::string yzhyi_command_str = yzhyi_command_line->
+      GetSwitchValueASCII(switches::kYzhyi);
+    command_line->AppendSwitchASCII(switches::kYzhyi, yzhyi_command_str);
+  }
+  // Yzhyi end
+
   // Pass the process type first, so it shows first in process listings.
   command_line->AppendSwitchASCII(switches::kProcessType,
                                   switches::kRendererProcess);
