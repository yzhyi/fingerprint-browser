+  if (fingerprint::Controller::GetInstance().GetNetworkInformation().Enabled()) {
+    fingerprint::Controller::GetInstance().GetNetworkInformation().ModifySaveDate(const_cast<NetworkInformation*>(this)->save_data_);
+    return save_data_;
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return IsObserving() ? save_data_
                        : GetNetworkStateNotifier().SaveDataEnabled();
 }
