diff --git a/a_tools/fingerprint/network_information/network_information.cc b/a_tools/fingerprint/network_information/network_information.cc
new file mode 100644
index 0000000000000..66f15e928f226
--- /dev/null
+++ b/a_tools/fingerprint/network_information/network_information.cc
@@ -0,0 +1,70 @@
+#include "./network_information.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+NetworkInformation::NetworkInformation(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+NetworkInformation::~NetworkInformation() = default;
+
+bool NetworkInformation::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "network_information"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+          FindDouble(params_dict, "rtt", m_rtt);
+          FindBool(params_dict, "save_data", m_save_data);
+          FindDouble(params_dict, "downlink_mbps", m_downlink_mbps);
+          FindString(params_dict, "effective_type", m_effective_type);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+void NetworkInformation::ModifyRTT(uint32_t &rtt) {
+  if (m_enabled) {
+    rtt = static_cast<uint32_t>(m_rtt);
+  }
+}
+
+void NetworkInformation::ModifySaveDate(bool &save_data) {
+  if (m_enabled) {
+    save_data = m_save_data;
+  }
+}
+
+void NetworkInformation::ModifyDownlink(double &downlink_mbps) {
+  if (m_enabled) {
+    downlink_mbps = m_downlink_mbps;
+  }
+}
+
+void NetworkInformation::ModifyEffectiveType(blink::WebEffectiveConnectionType &type) {
+  if (m_enabled) {
+    if (m_effective_type == "4g") {
+      type = blink::WebEffectiveConnectionType::kType4G;
+    }
+    else if (m_effective_type == "3g") {
+      type = blink::WebEffectiveConnectionType::kType3G;
+    }
+    else if (m_effective_type == "2g") {
+      type = blink::WebEffectiveConnectionType::kType2G;
+    }
+    else if (m_effective_type == "slow_2g") {
+      type = blink::WebEffectiveConnectionType::kTypeSlow2G;
+    }
+    else if (m_effective_type == "offline") {
+      type = blink::WebEffectiveConnectionType::kTypeOffline;
+    }
+    else {
+      type = blink::WebEffectiveConnectionType::kTypeUnknown;
+    }
+  }
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/network_information/network_information.h b/a_tools/fingerprint/network_information/network_information.h
new file mode 100644
index 0000000000000..954280d19703e
--- /dev/null
+++ b/a_tools/fingerprint/network_information/network_information.h
@@ -0,0 +1,37 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+#include "third_party/blink/public/platform/web_effective_connection_type.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class NetworkInformation : public BaseFingerprint {
+public:
+  friend Controller;
+  NetworkInformation(const NetworkInformation&) = delete;
+  NetworkInformation& operator=(const NetworkInformation&) = delete;
+
+private:
+  explicit NetworkInformation(const absl::optional<base::Value> &json_value);
+  ~NetworkInformation() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  BASE_EXPORT void ModifyRTT(uint32_t &rtt);
+  BASE_EXPORT void ModifySaveDate(bool &save_data);
+  BASE_EXPORT void ModifyDownlink(double &downlink_mbps);
+  BASE_EXPORT void ModifyEffectiveType(blink::WebEffectiveConnectionType &type);
+
+private:
+  double m_rtt{0};
+  bool m_save_data{false};
+  double m_downlink_mbps{0};
+  std::string m_effective_type{"4g"};
+};
+
+} // namespace fingerprint
