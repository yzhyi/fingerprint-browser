     "fingerprint/hardware_concurrency/hardware_concurrency.cc",
   ]
-
   deps = [
     "//base/allocator/partition_allocator:raw_ptr",
     "//third_party/abseil-cpp:absl",
   ]
-
-  # 编译配置（继承 Chromium 通用编译规则，如警告等级、C++ 标准等）
-  # 通常使用全局默认配置即可，无需额外添加
-  configs += [ "//build/config/compiler:wexit_time_destructors" ]
-
-  visibility = [ "*" ]  # 允许所有目标依赖
-
-  # 关键：将配置应用到当前库，并设为 public（让依赖模块继承）
-  public_configs = [ ":a_tools_config" ]
 }
