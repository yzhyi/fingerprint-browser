diff --git a/a_tools/fingerprint/window_screen/window_screen.cc b/a_tools/fingerprint/window_screen/window_screen.cc
new file mode 100644
index 0000000000000..212cdebb98953
--- /dev/null
+++ b/a_tools/fingerprint/window_screen/window_screen.cc
@@ -0,0 +1,119 @@
+#include "./window_screen.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <iostream>
+
+namespace fingerprint {
+
+WindowScreen::WindowScreen(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+WindowScreen::~WindowScreen() = default;
+
+bool WindowScreen::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "window_screen"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        if (const base::DictValue* screen_dict = FindDict(params_dict, "screen"); screen_dict) {
+          FindDouble(screen_dict, "width", m_screen.m_width);
+          FindDouble(screen_dict, "height", m_screen.m_height);
+          FindDouble(screen_dict, "avail_width", m_screen.m_avail_width);
+          FindDouble(screen_dict, "avail_height", m_screen.m_avail_height);
+          FindDouble(screen_dict, "avail_left", m_screen.m_avail_left);
+          FindDouble(screen_dict, "avail_top", m_screen.m_avail_top);
+          FindDouble(screen_dict, "color_depth", m_screen.m_color_depth);
+          FindDouble(screen_dict, "pixel_depth", m_screen.m_pixel_depth);
+        }
+
+
+        FindDouble(params_dict, "inner_width", m_inner_width);
+        FindDouble(params_dict, "inner_height", m_inner_height);
+        FindDouble(params_dict, "outer_width", m_outer_width);
+        FindDouble(params_dict, "outer_height", m_outer_height);
+
+        if (const base::DictValue* visual_viewport_dict = FindDict(params_dict, "visual_viewport"); visual_viewport_dict) {
+          FindDouble(visual_viewport_dict, "width", m_visual_viewport.m_width);
+          FindDouble(visual_viewport_dict, "height", m_visual_viewport.m_height);
+        }
+
+        FindDouble(params_dict, "device_pixel_ratio", m_device_pixel_ratio);
+        // NOTE: Yzhyi
+        // assert(m_inner_height <= m_screen.m_avail_height && m_inner_width <= m_screen.m_avail_width);
+        // assert(m_screen.m_avail_height <= m_screen.m_height && m_screen.m_avail_width <= m_screen.m_width);
+        // assert(m_inner_height < m_outer_height && m_inner_width < m_outer_width);
+        // assert(m_screen.m_color_depth == m_screen.m_pixel_depth);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+int WindowScreen::GetScreenWidth() {
+  return static_cast<int>(m_screen.m_width);
+}
+
+int WindowScreen::GetScreenHeight() {
+  return static_cast<int>(m_screen.m_height);
+}
+
+int WindowScreen::GetScreenAvailWidth() {
+  return static_cast<int>(m_screen.m_avail_width);
+}
+
+int WindowScreen::GetScreenAvailHeight() {
+  return static_cast<int>(m_screen.m_avail_height);
+}
+
+int WindowScreen::GetScreenAvailLeft() {
+  return static_cast<int>(m_screen.m_avail_left);
+}
+
+int WindowScreen::GetScreenAvailTop() {
+  return static_cast<int>(m_screen.m_avail_top);
+}
+
+unsigned WindowScreen::GetScreenColorDepth() {
+  return static_cast<unsigned>(m_screen.m_color_depth);
+}
+
+unsigned WindowScreen::GetScreenPixelDepth() {
+  return static_cast<unsigned>(m_screen.m_pixel_depth);
+}
+
+int WindowScreen::GetInnerWidth() {
+  return static_cast<int>(m_inner_width);
+}
+
+int WindowScreen::GetInnerHeight() {
+  return static_cast<int>(m_inner_height);
+}
+
+int WindowScreen::GetOuterWidth() {
+  return static_cast<int>(m_outer_width);
+}
+
+int WindowScreen::GetOuterHeight() {
+  return static_cast<int>(m_outer_height);
+}
+
+int WindowScreen::GetVisualViewportWidth() {
+  return m_visual_viewport.m_width;
+}
+
+int WindowScreen::GetVisualViewportHeight() {
+  return m_visual_viewport.m_height;
+}
+
+void WindowScreen::ModifyDevicePixelRatio(double &device_pixel_ratio) {
+  if (m_enabled) {
+    device_pixel_ratio = m_device_pixel_ratio;
+  }
+}
+
+} // namespace fingerprint
