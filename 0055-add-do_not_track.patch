 // found in the LICENSE file.
 
+#ifdef ENABLE_FINGERPRINT
+#include "a_tools/fingerprint/controller.h"
+#endif // ENABLE_FINGERPRINT
+
 #include "components/privacy_sandbox/tracking_protection_settings.h"
 
 #include "base/check.h"
@@ -113,6 +117,13 @@ bool TrackingProtectionSettings::IsFpProtectionEnabled() const {
 }
 
 bool TrackingProtectionSettings::IsDoNotTrackEnabled() const {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &do_not_track = fingerprint::Controller::GetInstance().GetDoNotTrack(); do_not_track.Enabled()) {
+    return do_not_track.GetDoNotTrack();
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return pref_service_->GetBoolean(prefs::kEnableDoNotTrack);
 }
 
