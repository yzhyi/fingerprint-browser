diff --git a/a_tools/fingerprint/do_not_track/do_not_track.cc b/a_tools/fingerprint/do_not_track/do_not_track.cc
new file mode 100644
index 0000000000000..8a57b4cbb7b99
--- /dev/null
+++ b/a_tools/fingerprint/do_not_track/do_not_track.cc
@@ -0,0 +1,32 @@
+#include "./do_not_track.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+#include <cstdint>
+#include <iostream>
+
+namespace fingerprint {
+
+DoNotTrack::DoNotTrack(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+DoNotTrack::~DoNotTrack() = default;
+
+bool DoNotTrack::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "do_not_track"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindBool(params_dict, "do_not_track", m_do_not_track);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+bool DoNotTrack::GetDoNotTrack() {
+  return m_do_not_track;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/do_not_track/do_not_track.h b/a_tools/fingerprint/do_not_track/do_not_track.h
new file mode 100644
index 0000000000000..480d01ee25799
--- /dev/null
+++ b/a_tools/fingerprint/do_not_track/do_not_track.h
@@ -0,0 +1,20 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+FINGERPRINT_CLASS_DECLARE(DoNotTrack);
+
+public:
+  BASE_EXPORT bool GetDoNotTrack();
+
+private:
+  bool m_do_not_track{false};
+
+FINGERPRINT_CLASS_END();
+
+} // namespace fingerprint
diff --git a/components/privacy_sandbox/tracking_protection_settings.cc b/components/privacy_sandbox/tracking_protection_settings.cc
index a416399d9e371..710752767bc52 100644
--- a/components/privacy_sandbox/tracking_protection_settings.cc
+++ b/components/privacy_sandbox/tracking_protection_settings.cc
@@ -2,6 +2,10 @@
