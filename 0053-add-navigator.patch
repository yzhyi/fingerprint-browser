--- a/a_tools/fingerprint/navigator/navigator.cc
+++ b/a_tools/fingerprint/navigator/navigator.cc
@@ -12,10 +12,19 @@ Navigator::~Navigator() = default;
 
 bool Navigator::ParseJson(const absl::optional<base::Value> &json_value) {
   if (!json_value) return false;
-  if (const base::DictValue* dict = FindDict(json_value.value(), "hardware_concurrency"); dict) {
+  if (const base::DictValue* dict = FindDict(json_value.value(), "navigator"); dict) {
     if (FindBool(dict, "enabled", m_enabled); m_enabled) {
       if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
-        FindDouble(params_dict, "cores", m_cores);
+        FindBool(params_dict, "cookie_enabled", m_cookie_enabled);
+        FindBool(params_dict, "webdriver", m_webdriver);
+        FindString(params_dict, "product_sub", m_product_sub);
+        FindString(params_dict, "vendor", m_vendor);
+        FindString(params_dict, "vendor_sub", m_vendor_sub);
+        FindString(params_dict, "platform", m_platform);
+        FindString(params_dict, "app_code_name", m_app_code_name);
+        FindString(params_dict, "app_name", m_app_name);
+        FindString(params_dict, "app_version", m_app_version);
+        FindString(params_dict, "product", m_product);
       }
     }
     return true;
@@ -23,11 +32,44 @@ bool Navigator::ParseJson(const absl::optional<base::Value> &json_value) {
   return false;
 }
 
-unsigned Navigator::ModifyHardwareConcurrency(unsigned cores) {
-  if (m_enabled) {
-    return m_cores;
-  }
-  return cores;
