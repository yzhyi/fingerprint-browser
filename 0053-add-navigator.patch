@@ -29,6 +29,10 @@
  * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
  */
 
+#ifdef ENABLE_FINGERPRINT
+#include "a_tools/fingerprint/controller.h"
+#endif // ENABLE_FINGERPRINT
+
 #include "third_party/blink/renderer/core/frame/navigator_id.h"
 
 #include "base/feature_list.h"
@@ -45,14 +49,35 @@
 namespace blink {
 
 String NavigatorID::appCodeName() {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled() && !navigator.GetAppCodeName().empty()) {
+    return String(navigator.GetAppCodeName());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return "Mozilla";
 }
 
 String NavigatorID::appName() {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled() && !navigator.GetAppName().empty()) {
+    return String(navigator.GetAppName());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return "Netscape";
 }
 
 String NavigatorID::appVersion() {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled() && !navigator.GetAppVersion().empty()) {
+    return String(navigator.GetAppVersion());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   // Version is everything in the user agent string past the "Mozilla/" prefix.
   const String& agent = userAgent();
   return agent.Substring(agent.find('/') + 1);
@@ -84,6 +109,13 @@ String NavigatorID::platform() const {
 }
 
 String NavigatorID::product() {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled() && !navigator.GetProduct().empty()) {
+    return String(navigator.GetProduct());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return "Gecko";
 }
 
