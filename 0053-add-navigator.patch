diff --git a/third_party/blink/renderer/core/frame/navigator.cc b/third_party/blink/renderer/core/frame/navigator.cc
index 1a73d4a8f097f..44ba6c3db09f6 100644
--- a/third_party/blink/renderer/core/frame/navigator.cc
+++ b/third_party/blink/renderer/core/frame/navigator.cc
@@ -21,6 +21,10 @@
  *  MA 02110-1301, USA
  */
 
+#ifdef ENABLE_FINGERPRINT
+#include "a_tools/fingerprint/controller.h"
+#endif // ENABLE_FINGERPRINT
+
 #include "third_party/blink/renderer/core/frame/navigator.h"
 
 #include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
@@ -43,10 +47,24 @@ namespace blink {
 Navigator::Navigator(ExecutionContext* context) : NavigatorBase(context) {}
 
 String Navigator::productSub() const {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled() && !navigator.GetProductSub().empty()) {
+    return String(navigator.GetProductSub());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return "20030107";
 }
 
 String Navigator::vendor() const {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled() && !navigator.GetVendor().empty()) {
+    return String(navigator.GetVendor());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   // Do not change without good cause. History:
   // https://code.google.com/p/chromium/issues/detail?id=276813
   // https://www.w3.org/Bugs/Public/show_bug.cgi?id=27786
@@ -55,10 +73,24 @@ String Navigator::vendor() const {
 }
 
 String Navigator::vendorSub() const {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled() && !navigator.GetVendorSub().empty()) {
+    return String(navigator.GetVendorSub());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return "";
 }
 
 String Navigator::platform() const {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled()) {
+    return String(navigator.GetPlatform());
+  }
+  #endif // ENABLE_FINGERPRINT
+
   // TODO(955620): Consider changing devtools overrides to only allow overriding
   // the platform with a frozen platform to distinguish between
   // mobile and desktop when ReduceUserAgent is enabled.
@@ -81,6 +113,12 @@ bool Navigator::cookieEnabled() const {
   Settings* settings = DomWindow()->GetFrame()->GetSettings();
   bool cookie_enabled = settings && settings->GetCookieEnabled();
 
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled()) {
+    return navigator.GetCookieEnabled();
+  }
+  #endif // ENABLE_FINGERPRINT
+
 #if !BUILDFLAG(IS_ANDROID)
   // We don't want to print this message for WebView, and the utility is much
   // lower for all Android platforms anyway, so it seems reasonable to skip.
@@ -101,6 +139,13 @@ bool Navigator::cookieEnabled() const {
 }
 
 bool Navigator::webdriver() const {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &navigator = fingerprint::Controller::GetInstance().GetNavigator(); navigator.Enabled()) {
+    return navigator.GetWebdriver();
+  }
+  #endif // ENABLE_FINGERPRINT
+
   if (RuntimeEnabledFeatures::AutomationControlledEnabled())
     return true;
 
diff --git a/third_party/blink/renderer/core/frame/navigator_id.cc b/third_party/blink/renderer/core/frame/navigator_id.cc
index 50a1727f8dbd5..4f654a8920efb 100644
