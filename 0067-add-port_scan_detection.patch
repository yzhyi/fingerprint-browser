diff --git a/a_tools/fingerprint/port_scan_protection/port_scan_protection.cc b/a_tools/fingerprint/port_scan_protection/port_scan_protection.cc
new file mode 100644
index 0000000000000..98ae510be5d5b
--- /dev/null
+++ b/a_tools/fingerprint/port_scan_protection/port_scan_protection.cc
@@ -0,0 +1,38 @@
+#include "./port_scan_protection.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+PortScanProtection::PortScanProtection(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+PortScanProtection::~PortScanProtection() = default;
+
+bool PortScanProtection::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "port_scan_protection"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        if (const base::ListValue* whitelist_dict = FindList(params_dict, "whitelist"); whitelist_dict) {
+          for (auto& port : *whitelist_dict) {
+            m_whitelist.emplace(static_cast<uint16_t>(port.GetDouble()));
+          }
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+bool PortScanProtection::IsProtected(std::string host, uint16_t port) {
+  if ((m_whitelist.find(port) == m_whitelist.end())
+    && (host == "127.0.0.1" || host == "::1" || host == "localhost")) {
+    return true;
+  }
+  return false;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/port_scan_protection/port_scan_protection.h b/a_tools/fingerprint/port_scan_protection/port_scan_protection.h
new file mode 100644
index 0000000000000..3b5e18c80695e
--- /dev/null
+++ b/a_tools/fingerprint/port_scan_protection/port_scan_protection.h
@@ -0,0 +1,21 @@
+# pragma once
+
+#include <unordered_set>
+
+#include "../base_fingerprint.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+FINGERPRINT_CLASS_DECLARE(PortScanProtection);
+
+public:
+  bool IsProtected(std::string host, uint16_t port);
+
+private:
+  std::unordered_set<uint16_t> m_whitelist;
+
+FINGERPRINT_CLASS_END();
+
+} // namespace fingerprint
