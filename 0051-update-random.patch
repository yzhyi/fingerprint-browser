+// Random 类的实现
+// 浮点数构造函数
+Random::Random(double min, double max, uint64_t seed)
+    : min_(min), max_(max), seed_(seed) {
+  // 参数验证
+  if (min_ > max_) {
+    LOG(ERROR) << "Invalid range: min (" << min_ << ") is greater than max (" << max_ << ")";
+  }
+
+  // 初始化独立的随机数引擎
+  if (seed_ != 0) {
+    engine_.seed(seed_);
+  } else {
+    uint64_t time_seed = std::chrono::steady_clock::now().time_since_epoch().count();
+    engine_.seed(time_seed);
+  }
+}
+
+// 生成随机整数
+int Random::NextInt() {
+  // 参数验证
+  if (min_ > max_) {
+    LOG(ERROR) << "Invalid range: min (" << min_ << ") is greater than max (" << max_ << ")";
+    return static_cast<int>(min_);
+  }
+
+  // 使用独立的引擎生成随机整数
+  std::uniform_int_distribution<int> distribution(static_cast<int>(min_), static_cast<int>(max_));
+  return distribution(engine_);
+}
+
+// 生成随机浮点数
+double Random::NextDouble() {
+  // 参数验证
+  if (min_ > max_) {
+    LOG(ERROR) << "Invalid range: min (" << min_ << ") is greater than max (" << max_ << ")";
+    return min_;
+  }
+
+  // 使用独立的引擎生成随机浮点数
+  std::uniform_real_distribution<double> distribution(min_, max_);
+  return distribution(engine_);
+}
+
 } // namespace fingerprint
