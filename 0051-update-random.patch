-BASE_EXPORT double RandomDouble(double min, double max, uint64_t seed = 0);
+double RandomDouble(double min, double max, uint64_t seed = 0);
+
+// 随机数生成器类
+class Random {
+public:
+  // 构造函数：指定浮点数范围和种子
+  Random(double min, double max, uint64_t seed = 0);
+
+  // 生成下一个随机整数
+  int NextInt();
+
+  // 生成下一个随机浮点数
+  double NextDouble();
+
+  // 获取当前的最小值
+  double GetMin() const { return min_; }
+
+  // 获取当前的最大值
+  double GetMax() const { return max_; }
+
+  // 获取当前的种子
+  uint64_t GetSeed() const { return seed_; }
+
+ private:
+  // 范围
+  double min_;
+  double max_;
+
+  // 种子
+  uint64_t seed_;
+
+  // 独立的随机数引擎
+  std::mt19937_64 engine_;
+};
 
 } // namespace fingerprint
