 namespace fingerprint {
 
+const char kYzhyi[] = "yzhyi";
+
 Controller::Controller()
   : m_command_line(base::CommandLine::ForCurrentProcess()) {
-  if (m_command_line->HasSwitch(switches::kYzhyi)) {
+  if (m_command_line->HasSwitch(kYzhyi)) {
     m_json_str = m_command_line->
-      GetSwitchValueASCII(switches::kYzhyi);
+      GetSwitchValueASCII(kYzhyi);
+    m_json_value = base::JSONReader::Read(m_json_str);
+    ParseJson();
   }
 }
 
@@ -22,15 +24,77 @@ Controller::~Controller() {}
 
 bool Controller::AppendCommandLine(base::CommandLine* command_line) {
   if (!m_json_str.empty()) {
-    command_line->AppendSwitchASCII(switches::kYzhyi, m_json_str);
+    command_line->AppendSwitchASCII(kYzhyi, m_json_str);
     return true;
   }
   return false;
 }
 
 void Controller::PrintJson() {
-  std::cout << m_json_str << std::endl;
-  LOG(INFO) << "---------------hello-------------------";
+  LOG(INFO) << "Controller::PrintJson: " << m_json_str;
+}
+
+void Controller::ParseJson() {
+  ParseCanvas();
+}
+
+bool Controller::ParseCanvas() {
+  base::DictValue* canvas_dict = m_json_value->GetDict().FindDict("canvas");
+  if (canvas_dict) {
+    std::optional<bool> canvas_enable = canvas_dict->FindBool("enable");
+    if (canvas_enable.has_value() && canvas_enable.value()) {
+      m_canvas_enable = canvas_enable.value();
+      base::DictValue* params_dict = canvas_dict->FindDict("params");
+      if (params_dict) {
+        std::optional<double> canvas_width = params_dict->FindDouble("width");
+        if (canvas_width.has_value()) {
+          m_canvas_width = canvas_width.value();
+        }
+        std::optional<double> canvas_height = params_dict->FindDouble("height");
+        if (canvas_height.has_value()) {
+          m_canvas_height = canvas_height.value();
+        }
+        std::optional<double> canvas_rect_x = params_dict->FindDouble("rect_x");
+        if (canvas_rect_x.has_value()) {
+          m_canvas_rect_x = canvas_rect_x.value();
+        }
+        std::optional<double> canvas_rect_y = params_dict->FindDouble("rect_y");
+        if (canvas_rect_y.has_value()) {
+          m_canvas_rect_y = canvas_rect_y.value();
+        }
+        std::optional<double> canvas_rect_width = params_dict->FindDouble("rect_width");
+        if (canvas_rect_width.has_value()) {
+          m_canvas_rect_width = canvas_rect_width.value();
+        }
+        std::optional<double> canvas_rect_height = params_dict->FindDouble("rect_height");
+        if (canvas_rect_height.has_value()) {
+          m_canvas_rect_height = canvas_rect_height.value();
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+bool Controller::ParseWebGL() {
+  base::DictValue* webgl_dict = m_json_value->GetDict().FindDict("webgl");
+  if (webgl_dict) {
+    std::optional<bool> webgl_enable = webgl_dict->FindBool("enable");
+    if (webgl_enable.has_value() && webgl_enable.value()) {
+      m_webgl_enable = webgl_enable.value();
+      base::DictValue* params_dict = webgl_dict->FindDict("params");
+      if (params_dict) {
+        std::optional<double> canvas_width = params_dict->FindDouble("width");
+        if (canvas_width.has_value()) {
+          m_canvas_width = canvas_width.value();
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+
 }
 
 }
