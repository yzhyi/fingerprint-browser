From 721a14b5aa602b915e857bb0e1a1c5e48a084cd8 Mon Sep 17 00:00:00 2001
From: yuzhengyi02 <yuzhengyi02@meituan.com>
Date: Thu, 4 Sep 2025 14:04:10 +0800
Subject: [PATCH 03/68] Canvas: fillRect

---
 .../core/html/canvas/html_canvas_element.cc   | 28 +++++++--------
 .../canvas2d/canvas_2d_recorder_context.cc    | 35 +++++++++++++++++++
 2 files changed, 49 insertions(+), 14 deletions(-)

diff --git a/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc b/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
index a3c201d061eec..dc8318c52cc53 100644
--- a/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
+++ b/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
@@ -535,8 +535,8 @@ bool HTMLCanvasElement::SizeChangesAreAllowed(ExceptionState& exception_state) {
   return true;
 }
 
-void HTMLCanvasElement::setHeight(unsigned value,
-                                  ExceptionState& exception_state) {
+void HTMLCanvasElement::setWidth(unsigned value,
+                                 ExceptionState& exception_state) {
   if (SizeChangesAreAllowed(exception_state)) {
     // Yzhyi start
     const base::CommandLine *yzhyi_command_line =
@@ -546,19 +546,19 @@ void HTMLCanvasElement::setHeight(unsigned value,
         GetSwitchValueASCII(switches::kYzhyi);
       absl::optional<base::Value> yzhyi_command_value =
         base::JSONReader::Read(yzhyi_command_str);
-      std::optional<double> canvas_height = yzhyi_command_value->GetDict().FindDouble("canvas_height");
-      if (canvas_height.has_value()) {
-        value += canvas_height.value();
+      std::optional<double> canvas_width = yzhyi_command_value->GetDict().FindDouble("canvas_set_width");
+      if (canvas_width.has_value()) {
+        value += canvas_width.value();
       }
     }
     // Yzhyi end
-    SetUnsignedIntegralAttribute(html_names::kHeightAttr, value,
-                                 kDefaultCanvasHeight);
+    SetUnsignedIntegralAttribute(html_names::kWidthAttr, value,
+                                 kDefaultCanvasWidth);
   }
 }
 
-void HTMLCanvasElement::setWidth(unsigned value,
-                                 ExceptionState& exception_state) {
+void HTMLCanvasElement::setHeight(unsigned value,
+                                  ExceptionState& exception_state) {
   if (SizeChangesAreAllowed(exception_state)) {
     // Yzhyi start
     const base::CommandLine *yzhyi_command_line =
@@ -568,14 +568,14 @@ void HTMLCanvasElement::setWidth(unsigned value,
         GetSwitchValueASCII(switches::kYzhyi);
       absl::optional<base::Value> yzhyi_command_value =
         base::JSONReader::Read(yzhyi_command_str);
-      std::optional<double> canvas_width = yzhyi_command_value->GetDict().FindDouble("canvas_width");
-      if (canvas_width.has_value()) {
-        value += canvas_width.value();
+      std::optional<double> canvas_height = yzhyi_command_value->GetDict().FindDouble("canvas_set_height");
+      if (canvas_height.has_value()) {
+        value += canvas_height.value();
       }
     }
     // Yzhyi end
-    SetUnsignedIntegralAttribute(html_names::kWidthAttr, value,
-                                 kDefaultCanvasWidth);
+    SetUnsignedIntegralAttribute(html_names::kHeightAttr, value,
+                                 kDefaultCanvasHeight);
   }
 }
 
diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc b/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc
index 87f9a86757c24..9dc23bdbeacd9 100644
--- a/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc
@@ -2,6 +2,14 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+// Yzhyi start
+#include "base/command_line.h"
+#include "third_party/blink/public/common/switches.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+// Yzhyi end
+
 #include "third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.h"
 
 #include <algorithm>
@@ -1912,6 +1920,33 @@ void Canvas2DRecorderContext::fillRect(double x,
         GPUFallbackToCPUScenario::kLargePatternDrawnToGPU);
   }
 
+  // Yzhyi start
+  const base::CommandLine *yzhyi_command_line =
+    base::CommandLine::ForCurrentProcess();
+  if (yzhyi_command_line->HasSwitch(switches::kYzhyi)) {
+    std::string yzhyi_command_str = yzhyi_command_line->
+      GetSwitchValueASCII(switches::kYzhyi);
+    absl::optional<base::Value> yzhyi_command_value =
+      base::JSONReader::Read(yzhyi_command_str);
+    std::optional<double> canvas_fill_rect_x = yzhyi_command_value->GetDict().FindDouble("canvas_fill_rect_x");
+    if (canvas_fill_rect_x.has_value()) {
+      x += canvas_fill_rect_x.value();
+    }
+    std::optional<double> canvas_fill_rect_y = yzhyi_command_value->GetDict().FindDouble("canvas_fill_rect_y");
+    if (canvas_fill_rect_y.has_value()) {
+      y += canvas_fill_rect_y.value();
+    }
+    std::optional<double> canvas_fill_rect_width = yzhyi_command_value->GetDict().FindDouble("canvas_fill_rect_width");
+    if (canvas_fill_rect_width.has_value()) {
+      width += canvas_fill_rect_width.value();
+    }
+    std::optional<double> canvas_fill_rect_height = yzhyi_command_value->GetDict().FindDouble("canvas_fill_rect_height");
+    if (canvas_fill_rect_height.has_value()) {
+      height += canvas_fill_rect_height.value();
+    }
+  }
+  // Yzhyi end
+
   // clamp to float to avoid float cast overflow when used as SkScalar
   AdjustRectForCanvas(x, y, width, height);
   gfx::RectF rect(ClampTo<float>(x), ClampTo<float>(y), ClampTo<float>(width),
-- 
2.43.0

