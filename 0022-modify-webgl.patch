diff --git a/a_tools/fingerprint/webgl/webgl.cc b/a_tools/fingerprint/webgl/webgl.cc
new file mode 100644
index 0000000000000..cbd75e95f0175
--- /dev/null
+++ b/a_tools/fingerprint/webgl/webgl.cc
@@ -0,0 +1,103 @@
+#include "webgl.h"
+
+namespace fingerprint {
+
+WebGL::WebGL(absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+WebGL::~WebGL() = default;
+
+bool WebGL::ParseJson(absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  base::DictValue* dict = json_value->GetDict().FindDict("webgl");
+  if (dict) {
+    std::optional<bool> enabled = dict->FindBool("enabled");
+    if (enabled.has_value() && enabled.value()) {
+      m_enabled = enabled.value();
+      base::DictValue* params_dict = dict->FindDict("params");
+      if (params_dict) {
+        std::string* unmasked_vendor_webgl = params_dict->FindString("unmasked_vendor_webgl");
+        if (unmasked_vendor_webgl) {
+          m_unmasked_vendor_webgl = *unmasked_vendor_webgl;
+        }
+        std::string* unmasked_renderer_webgl = params_dict->FindString("unmasked_renderer_webgl");
+        if (unmasked_renderer_webgl) {
+          m_unmasked_renderer_webgl = *unmasked_renderer_webgl;
+        }
+      }
+      base::DictValue* extensions_dict = dict->FindDict("extensions");
+      if (extensions_dict) {
+        std::optional<bool> extensions_random_shuffle = extensions_dict->FindBool("random_shuffle");
+        if (extensions_random_shuffle.has_value()) {
+          m_extensions_random_shuffle_enable = extensions_random_shuffle.value();
+        }
+      }
+      base::DictValue* pixels_dict = dict->FindDict("pixels");
+      if (pixels_dict) {
+        std::optional<double> pixels_x = pixels_dict->FindDouble("x");
+        if (pixels_x.has_value()) {
+          m_pixels_x = pixels_x.value();
+        }
+        std::optional<double> pixels_y = pixels_dict->FindDouble("y");
+        if (pixels_y.has_value()) {
+          m_pixels_y = pixels_y.value();
+        }
+        std::optional<double> pixels_width = pixels_dict->FindDouble("width");
+        if (pixels_width.has_value()) {
+          m_pixels_width = pixels_width.value();
+        }
+        std::optional<double> pixels_height = pixels_dict->FindDouble("height");
+        if (pixels_height.has_value()) {
+          m_pixels_height = pixels_height.value();
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+std::string WebGL::GetUnmaskedVendorWebgl() {
+  if (m_enabled) {
+    return m_unmasked_vendor_webgl;
+  }
+  return "";
+}
+
+std::string WebGL::GetUnmaskedRendererWebgl() {
+  if (m_enabled) {
+    return m_unmasked_renderer_webgl;
+  }
+  return "";
+}
+
+bool WebGL::ExtensionsRandomShuffleEnable() {
+  return m_extensions_random_shuffle_enable;
+}
+
+void WebGL::ModifyPixelsX(int &value) {
+  if (m_enabled) {
+    value += static_cast<int>(m_pixels_x);
+  }
+}
+
+void WebGL::ModifyPixelsY(int &value) {
+  if (m_enabled) {
+    value += static_cast<int>(m_pixels_y);
+  }
+}
+
+void WebGL::ModifyPixelsWidth(int &value) {
+  if (m_enabled) {
+    value += static_cast<int>(m_pixels_width);
+  }
+}
+
+void WebGL::ModifyPixelsHeight(int &value) {
+  if (m_enabled) {
+    value += static_cast<int>(m_pixels_height);
+  }
+}
+
+} // namespace fingerprint
