@@ -0,0 +1,45 @@
+# pragma once
+
+#include <string>
+#include <unordered_map>
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class WebGL {
+public:
+  friend Controller;
+  WebGL(const WebGL&) = delete;
+  WebGL& operator=(const WebGL&) = delete;
+
+private:
+  explicit WebGL(absl::optional<base::Value> &json_value);
+  ~WebGL();
+  
+public:
+  bool ParseJson(absl::optional<base::Value> &json_value);
+  bool Enabled() { return m_enabled; }
+
+  std::string GetUnmaskedVendorWebgl();
+  std::string GetUnmaskedRendererWebgl();
+  bool ExtensionsRandomShuffleEnable();
+  void ModifyPixelsX(int &value);
+  void ModifyPixelsY(int &value);
+  void ModifyPixelsWidth(int &value);
+  void ModifyPixelsHeight(int &value);
+
+private:
+  bool m_enabled{false};
+  std::string m_unmasked_vendor_webgl;
+  std::string m_unmasked_renderer_webgl;
+  bool m_extensions_random_shuffle_enable{false};
+  double m_pixels_x{0};
+  double m_pixels_y{0};
+  double m_pixels_width{0};
+  double m_pixels_height{0};
+};
+
+} // namespace fingerprint
