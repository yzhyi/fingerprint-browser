diff --git a/a_tools/fingerprint/window/window.cc b/a_tools/fingerprint/window/window.cc
new file mode 100644
index 0000000000000..acc013837f183
--- /dev/null
+++ b/a_tools/fingerprint/window/window.cc
@@ -0,0 +1,70 @@
+#include "./window.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+#include <cstdint>
+#include <cstdio>
+#include <iostream>
+
+namespace fingerprint {
+
+Window::Window(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Window::~Window() = default;
+
+bool Window::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "window"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        if (const base::DictValue* screen_dict = FindDict(params_dict, "screen"); screen_dict) {
+          FindDouble(screen_dict, "width", m_screen.m_width);
+          FindDouble(screen_dict, "height", m_screen.m_height);
+          FindDouble(screen_dict, "avail_width", m_screen.m_avail_width);
+          FindDouble(screen_dict, "avail_height", m_screen.m_avail_height);
+          FindDouble(screen_dict, "avail_left", m_screen.m_avail_left);
+          FindDouble(screen_dict, "avail_top", m_screen.m_avail_top);
+          FindDouble(screen_dict, "color_depth", m_screen.m_color_depth);
+          FindDouble(screen_dict, "pixel_depth", m_screen.m_pixel_depth);
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+int Window::GetScreenWidth() {
+  return static_cast<int>(m_screen.m_width);
+}
+
+int Window::GetScreenHeight() {
+  return static_cast<int>(m_screen.m_height);
+}
+
+int Window::GetScreenAvailWidth() {
+  return static_cast<int>(m_screen.m_avail_width);
+}
+
+int Window::GetScreenAvailHeight() {
+  return static_cast<int>(m_screen.m_avail_height);
+}
+
+int Window::GetScreenAvailLeft() {
+  return static_cast<int>(m_screen.m_avail_left);
+}
+
+int Window::GetScreenAvailTop() {
+  return static_cast<int>(m_screen.m_avail_top);
+}
+
+unsigned Window::GetScreenColorDepth() {
+  return static_cast<unsigned>(m_screen.m_color_depth);
+}
+
+unsigned Window::GetScreenPixelDepth() {
+  return static_cast<unsigned>(m_screen.m_pixel_depth);
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/window/window.h b/a_tools/fingerprint/window/window.h
new file mode 100644
index 0000000000000..d5a67d8a37578
--- /dev/null
+++ b/a_tools/fingerprint/window/window.h
@@ -0,0 +1,46 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class Window : public BaseFingerprint {
+public:
+  friend Controller;
+  Window(const Window&) = delete;
+  Window& operator=(const Window&) = delete;
+
+private:
+  explicit Window(const absl::optional<base::Value> &json_value);
+  ~Window() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  BASE_EXPORT int GetScreenWidth();
+  BASE_EXPORT int GetScreenHeight();
+  BASE_EXPORT int GetScreenAvailWidth();
+  BASE_EXPORT int GetScreenAvailHeight();
+  BASE_EXPORT int GetScreenAvailLeft();
+  BASE_EXPORT int GetScreenAvailTop();
+  BASE_EXPORT unsigned GetScreenColorDepth();
+  BASE_EXPORT unsigned GetScreenPixelDepth();
+
+private:
+  struct Screen {
+    double m_width{0};
+    double m_height{0};
+    double m_avail_width{0};
+    double m_avail_height{0};
+    double m_avail_left{0};
+    double m_avail_top{0};
+    double m_color_depth{0};
+    double m_pixel_depth{0};
+  } m_screen;
+};
+
+} // namespace fingerprint
