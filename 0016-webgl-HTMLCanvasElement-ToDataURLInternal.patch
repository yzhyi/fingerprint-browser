 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/config.json b/config.json
index 88394d2d33b2d..2207bd91de33c 100644
--- a/config.json
+++ b/config.json
@@ -2,7 +2,7 @@
   "canvas": {
     "enable": false,
     "params": {
-      "width": 0,
+      "width": 1,
       "height": 0,
       "rect_x": 0,
       "rect_y": 0,
@@ -11,13 +11,15 @@
     }
   },
   "webgl": {
-    "enable": false,
+    "enable": true,
     "params": {
-      "unmasked_vendor_webgl": "Google Inc. (NVIDIA)",
-      "unmasked_renderer_webgl": "ANGLE (NVIDIA, NVIDIA GeForce RTX 2060 SUPER Direct3D11 vs_5_0 ps_5_0, D3D11-30.0.14.9676)"
+      "#unmasked_vendor_webgl": "Google Inc. (Apple)",
+      "#unmasked_renderer_webgl": "ANGLE (Apple, ANGLE Metal Renderer: Apple M4 Pro, Unspecified Version)",
+      "#unmasked_vendor_webgl": "Google Inc. (NVIDIA)",
+      "#unmasked_renderer_webgl": "ANGLE (NVIDIA, NVIDIA GeForce RTX 2060 SUPER Direct3D11 vs_5_0 ps_5_0, D3D11-30.0.14.9676)"
     },
     "extensions": {
-      "random_shuffle": false
+      "random_shuffle": true
     },
     "pixels": {
       "x": 0,
diff --git a/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc b/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
index 2796f71b94f39..7ada12d5c5572 100644
--- a/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
+++ b/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
@@ -1436,6 +1436,11 @@ String HTMLCanvasElement::ToDataURLInternal(const String& mime_type,
           TRACE_DISABLED_BY_DEFAULT("identifiability.high_entropy_api"),
           "CanvasReadback", "data_url", data_url.Utf8(), "noised", noised);
     }
+    // Yzhyi start
+    if (fingerprint::Controller::GetInstance().WebGLEnable()) {
+      return data_url + String(" ");
+    }
+    // Yzhyi end
     return data_url;
   }
 
