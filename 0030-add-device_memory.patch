diff --git a/a_tools/fingerprint/device_memory/device_memory.cc b/a_tools/fingerprint/device_memory/device_memory.cc
new file mode 100644
index 0000000000000..fd599d9522d41
--- /dev/null
+++ b/a_tools/fingerprint/device_memory/device_memory.cc
@@ -0,0 +1,32 @@
+#include "device_memory.h"
+#include "a_tools/fingerprint/utils/random.h"
+#include "a_tools/fingerprint/utils/parse_json.h"
+
+namespace fingerprint {
+
+DeviceMemory::DeviceMemory(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+DeviceMemory::~DeviceMemory() = default;
+
+bool DeviceMemory::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "device_memory"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindDouble(params_dict, "gb", m_gb);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+void DeviceMemory::ModifyDeviceMemory(float &gb) {
+  if (m_enabled) {
+    gb = m_gb;
+  }
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/device_memory/device_memory.h b/a_tools/fingerprint/device_memory/device_memory.h
new file mode 100644
index 0000000000000..671292ca8d015
--- /dev/null
+++ b/a_tools/fingerprint/device_memory/device_memory.h
@@ -0,0 +1,29 @@
+# pragma once
+
+#include "a_tools/fingerprint/base_fingerprint.h"
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class DeviceMemory : public BaseFingerprint {
+public:
+  friend Controller;
+  DeviceMemory(const DeviceMemory&) = delete;
+  DeviceMemory& operator=(const DeviceMemory&) = delete;
+
+private:
+  explicit DeviceMemory(const absl::optional<base::Value> &json_value);
+  ~DeviceMemory() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  void ModifyDeviceMemory(float &gb);
+
+private:
+  double m_gb{0};
+};
+
+} // namespace fingerprint
