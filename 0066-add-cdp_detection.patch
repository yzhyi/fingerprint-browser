+// 静态辅助函数：解析 JSON 字符串，利用静态变量确保只解析一次
+static const absl::optional<base::Value>& GetParsedJson(bool enabled, const std::string& json_str) {
+  static bool initialized = false;
+  static absl::optional<base::Value> cached_json_value;
+
+  if (!initialized) {
+    initialized = true;
+    if (enabled && !json_str.empty()) {
+      cached_json_value = base::JSONReader::Read(json_str);
+    }
+  }
+
+  return cached_json_value;
+}
+
+// CommandLineHolder 的实现 - 隐藏 raw_ptr 在 .cc 文件中
+class CommandLineHolder {
+ public:
+  CommandLineHolder() : m_command_line(base::CommandLine::ForCurrentProcess()) {}
+
+  raw_ptr<const base::CommandLine> m_command_line;
+};
