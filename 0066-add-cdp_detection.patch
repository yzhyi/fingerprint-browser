index 0000000000000..b2e2eadfea7e1
--- /dev/null
+++ b/a_tools/fingerprint/cdp_detection/cdp_detection.cc
@@ -0,0 +1,51 @@
+#include "./cdp_detection.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+CdpDetection::CdpDetection(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+CdpDetection::~CdpDetection() = default;
+
+bool CdpDetection::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "cdp_detection"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        if (const base::DictValue* console_api_dict = FindDict(params_dict, "console_api"); console_api_dict) {
+          FindBool(console_api_dict, "debug_disabled", m_console_api_debug_disabled);
+          FindBool(console_api_dict, "error_disabled", m_console_api_error_disabled);
+          FindBool(console_api_dict, "info_disabled", m_console_api_info_disabled);
+          FindBool(console_api_dict, "log_disabled", m_console_api_log_disabled);
+          FindBool(console_api_dict, "warn_disabled", m_console_api_warn_disabled);
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+bool CdpDetection::ConsoleApiDebugDisabled() {
+  return m_console_api_debug_disabled;
+}
+
+bool CdpDetection::ConsoleApiErrorDisabled() {
+  return m_console_api_error_disabled;
+}
+
+bool CdpDetection::ConsoleApiInfoDisabled() {
+  return m_console_api_info_disabled;
+}
+
+bool CdpDetection::ConsoleApiLogDisabled() {
+  return m_console_api_log_disabled;
+}
+
+bool CdpDetection::ConsoleApiWarnDisabled() {
+  return m_console_api_warn_disabled;
+}
+
+} // namespace fingerprint
