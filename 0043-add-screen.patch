diff --git a/a_tools/fingerprint/screen/screen.cc b/a_tools/fingerprint/screen/screen.cc
new file mode 100644
index 0000000000000..af688b252dbbf
--- /dev/null
+++ b/a_tools/fingerprint/screen/screen.cc
@@ -0,0 +1,68 @@
+#include "./screen.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+#include <cstdint>
+#include <cstdio>
+#include <iostream>
+
+namespace fingerprint {
+
+Screen::Screen(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Screen::~Screen() = default;
+
+bool Screen::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "screen"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindDouble(params_dict, "width", m_width);
+        FindDouble(params_dict, "height", m_height);
+        FindDouble(params_dict, "avail_width", m_avail_width);
+        FindDouble(params_dict, "avail_height", m_avail_height);
+        FindDouble(params_dict, "avail_left", m_avail_left);
+        FindDouble(params_dict, "avail_top", m_avail_top);
+        FindDouble(params_dict, "color_depth", m_color_depth);
+        FindDouble(params_dict, "pixel_depth", m_pixel_depth);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+int Screen::GetWidth() {
+  return static_cast<int>(m_width);
+}
+
+int Screen::GetHeight() {
+  return static_cast<int>(m_height);
+}
+
+int Screen::GetAvailWidth() {
+  return static_cast<int>(m_avail_width);
+}
+
+int Screen::GetAvailHeight() {
+  return static_cast<int>(m_avail_height);
+}
+
+int Screen::GetAvailLeft() {
+  return static_cast<int>(m_avail_left);
+}
+
+int Screen::GetAvailTop() {
+  return static_cast<int>(m_avail_top);
+}
+
+unsigned Screen::GetColorDepth() {
+  return static_cast<unsigned>(m_color_depth);
+}
+
+unsigned Screen::GetPixelDepth() {
+  return static_cast<unsigned>(m_pixel_depth);
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/screen/screen.h b/a_tools/fingerprint/screen/screen.h
new file mode 100644
index 0000000000000..9bc6b40fdc258
--- /dev/null
+++ b/a_tools/fingerprint/screen/screen.h
@@ -0,0 +1,44 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class Screen : public BaseFingerprint {
+public:
+  friend Controller;
+  Screen(const Screen&) = delete;
+  Screen& operator=(const Screen&) = delete;
+
+private:
+  explicit Screen(const absl::optional<base::Value> &json_value);
+  ~Screen() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  BASE_EXPORT int GetWidth();
+  BASE_EXPORT int GetHeight();
+  BASE_EXPORT int GetAvailWidth();
+  BASE_EXPORT int GetAvailHeight();
+  BASE_EXPORT int GetAvailLeft();
+  BASE_EXPORT int GetAvailTop();
+  BASE_EXPORT unsigned GetColorDepth();
+  BASE_EXPORT unsigned GetPixelDepth();
+
+private:
+  double m_width{0};
+  double m_height{0};
+  double m_avail_width{0};
+  double m_avail_height{0};
+  double m_avail_left{0};
+  double m_avail_top{0};
+  double m_color_depth{0};
+  double m_pixel_depth{0};
+};
+
+} // namespace fingerprint
