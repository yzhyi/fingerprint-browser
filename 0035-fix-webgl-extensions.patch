     "params": {
       "#unmasked_vendor_webgl": "Google Inc. (Apple)",
       "#unmasked_renderer_webgl": "ANGLE (Apple, ANGLE Metal Renderer: Apple M4 Pro, Unspecified Version)",
       "#unmasked_vendor_webgl": "Google Inc. (NVIDIA)",
       "#unmasked_renderer_webgl": "ANGLE (NVIDIA, NVIDIA GeForce RTX 2060 SUPER Direct3D11 vs_5_0 ps_5_0, D3D11-30.0.14.9676)",
       "extensions": {
-        "random_shuffle": false
+        "add": [
+          "yzhyi"
+        ],
+        "sub": [
+          "ANGLE_instanced_arrays"
+        ]
       },
       "pixels": {
         "x": 1,
@@ -86,13 +91,13 @@
     }
   },
   "device_memory": {
-    "enabled": true,
+    "enabled": false,
     "params": {
       "GiB": 2
     }
   },
   "hardware_concurrency": {
-    "enabled": true,
+    "enabled": false,
     "params": {
       "cores": 8
     }
diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
index dc729140a656c..a4bbf4f4fdc1c 100644
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -25,6 +25,7 @@
 
 // Yzhyi start
 #include "a_tools/fingerprint/controller.h"
+#include <unordered_set>
 // Yzhyi end
 
 #include "third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.h"
@@ -4418,8 +4419,17 @@ WebGLRenderingContextBase::getSupportedExtensions() {
   }
 
   // Yzhyi start
-  // fingerprint::Controller::GetInstance().GetWebGL().RandomShuffleExtensions(result);
-  // TODO: Yzhyi can customize
+  if (fingerprint::Controller::GetInstance().GetWebGL().Enabled()) {
+    std::unordered_set<std::string> tmp;
+    for (auto it : result) {
+      tmp.insert(it.Ascii());
+    }
+    fingerprint::Controller::GetInstance().GetWebGL().ModifyExtensions(tmp);
+    result.clear();
+    for (auto it : tmp) {
+      result.push_back(it);
+    }
+  }
   // Yzhyi end
 
   return result;
