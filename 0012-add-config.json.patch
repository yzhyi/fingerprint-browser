@@ -83,11 +84,41 @@ bool Controller::ParseWebGL() {
     std::optional<bool> webgl_enable = webgl_dict->FindBool("enable");
     if (webgl_enable.has_value() && webgl_enable.value()) {
       m_webgl_enable = webgl_enable.value();
-      base::DictValue* params_dict = webgl_dict->FindDict("params");
-      if (params_dict) {
-        std::optional<double> canvas_width = params_dict->FindDouble("width");
-        if (canvas_width.has_value()) {
-          m_canvas_width = canvas_width.value();
+      base::DictValue* webgl_params_dict = webgl_dict->FindDict("params");
+      if (webgl_params_dict) {
+        std::string* webgl_unmasked_vendor_webgl = webgl_params_dict->FindString("unmasked_vendor_webgl");
+        if (webgl_unmasked_vendor_webgl) {
+          m_webgl_unmasked_vendor_webgl = *webgl_unmasked_vendor_webgl;
+        }
+        std::string* webgl_unmasked_renderer_webgl = webgl_params_dict->FindString("unmasked_renderer_webgl");
+        if (webgl_unmasked_renderer_webgl) {
+          m_webgl_unmasked_renderer_webgl = *webgl_unmasked_renderer_webgl;
+        }
+      }
+      base::DictValue* webgl_extensions_dict = webgl_dict->FindDict("extensions");
+      if (webgl_extensions_dict) {
+        std::optional<bool> webgl_extensions_random_shuffle = webgl_extensions_dict->FindBool("random_shuffle");
+        if (webgl_extensions_random_shuffle.has_value() && webgl_extensions_random_shuffle.value()) {
+          m_webgl_extensions_random_shuffle = webgl_extensions_random_shuffle.value();
+        }
+      }
+      base::DictValue* webgl_pixels_dict = webgl_dict->FindDict("pixels");
+      if (webgl_pixels_dict) {
+        std::optional<double> webgl_pixels_x = webgl_pixels_dict->FindDouble("x");
+        if (webgl_pixels_x.has_value()) {
+          m_webgl_pixels_x = webgl_pixels_x.value();
+        }
+        std::optional<double> webgl_pixels_y = webgl_pixels_dict->FindDouble("y");
+        if (webgl_pixels_y.has_value()) {
+          m_webgl_pixels_y = webgl_pixels_y.value();
+        }
+        std::optional<double> webgl_pixels_width = webgl_pixels_dict->FindDouble("width");
+        if (webgl_pixels_width.has_value()) {
+          m_webgl_pixels_width = webgl_pixels_width.value();
+        }
+        std::optional<double> webgl_pixels_height = webgl_pixels_dict->FindDouble("height");
+        if (webgl_pixels_height.has_value()) {
+          m_webgl_pixels_height = webgl_pixels_height.value();
         }
       }
     }
