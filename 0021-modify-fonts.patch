diff --git a/a_tools/fingerprint/fonts/fonts.cc b/a_tools/fingerprint/fonts/fonts.cc
new file mode 100644
index 0000000000000..9ef428eeb979d
--- /dev/null
+++ b/a_tools/fingerprint/fonts/fonts.cc
@@ -0,0 +1,41 @@
+#include "fonts.h"
+#include "a_tools/fingerprint/utils/random.h"
+
+namespace fingerprint {
+
+Fonts::Fonts(absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Fonts::~Fonts() = default;
+
+bool Fonts::ParseJson(absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  base::DictValue* dict = json_value->GetDict().FindDict("fonts");
+  if (dict) {
+    std::optional<bool> enabled = dict->FindBool("enabled");
+    if (enabled.has_value() && enabled.value()) {
+      m_enabled = enabled.value();
+      base::DictValue* params_dict = dict->FindDict("params");
+      if (params_dict) {
+        std::optional<double> noise_min = params_dict->FindDouble("noise_min");
+        if (noise_min.has_value()) {
+          m_noise_min = noise_min.value();
+        }
+        std::optional<double> noise_max = params_dict->FindDouble("noise_max");
+        if (noise_max.has_value()) {
+          m_noise_max = noise_max.value();
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+int Fonts::GetNoise() {
+  return RandomInt(static_cast<int>(m_noise_min),
+                    static_cast<int>(m_noise_max));
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/fonts/fonts.h b/a_tools/fingerprint/fonts/fonts.h
new file mode 100644
index 0000000000000..b7bc5f45fdf9b
--- /dev/null
+++ b/a_tools/fingerprint/fonts/fonts.h
@@ -0,0 +1,35 @@
+# pragma once
+
+#include <string>
+#include <unordered_map>
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class Fonts {
+public:
+  friend Controller;
+  Fonts(const Fonts&) = delete;
+  Fonts& operator=(const Fonts&) = delete;
+
+private:
+  explicit Fonts(absl::optional<base::Value> &json_value);
+  ~Fonts();
+  
+public:
+  bool ParseJson(absl::optional<base::Value> &json_value);
+  bool Enabled() { return m_enabled; }
+
+  int GetNoise();
+
+private:
+  bool m_enabled{false};
+
+  double m_noise_min{0};
+  double m_noise_max{0};
+};
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/utils/random.cc b/a_tools/fingerprint/utils/random.cc
new file mode 100644
index 0000000000000..715f2d95fb8e1
--- /dev/null
+++ b/a_tools/fingerprint/utils/random.cc
@@ -0,0 +1,19 @@
+#include <random>
+
+#include "random.h"
+#include "base/logging.h"
+
+namespace fingerprint {
+
+int RandomInt(int min, int max) {
+  if (min > max) {
+    LOG(ERROR) << "Invalid range: min (" << min << ") is greater than max (" << max << ")";
+  }
+  static std::mt19937_64 engine(
+    std::chrono::steady_clock::now().time_since_epoch().count()
+  );
+  std::uniform_int_distribution<int> distribution(min, max);
+  return distribution(engine);
+}
+
+} // namespace fingerprint
