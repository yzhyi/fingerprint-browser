diff --git a/a_tools/fingerprint/webaudio/webaudio.cc b/a_tools/fingerprint/webaudio/webaudio.cc
new file mode 100644
index 0000000000000..f252a39f28714
--- /dev/null
+++ b/a_tools/fingerprint/webaudio/webaudio.cc
@@ -0,0 +1,38 @@
+#include "./webaudio.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+WebAudio::WebAudio(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+WebAudio::~WebAudio() = default;
+
+bool WebAudio::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "webaudio"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        if (const base::DictValue* sample_rate_dict = FindDict(params_dict, "sample_rate"); sample_rate_dict) {
+          FindDouble(sample_rate_dict, "seed", m_sample_rate.m_seed);
+          FindDouble(sample_rate_dict, "noise_min", m_sample_rate.m_noise_min);
+          FindDouble(sample_rate_dict, "noise_max", m_sample_rate.m_noise_max);
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+void WebAudio::ModifySampleRate(float &sample_rate) {
+  if (m_enabled) {
+    sample_rate += RandomDouble(m_sample_rate.m_noise_min,
+                                m_sample_rate.m_noise_max,
+                               static_cast<uint64_t>(m_sample_rate.m_seed));
+  }
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/webaudio/webaudio.h b/a_tools/fingerprint/webaudio/webaudio.h
new file mode 100644
index 0000000000000..6c66a53ca695a
--- /dev/null
+++ b/a_tools/fingerprint/webaudio/webaudio.h
@@ -0,0 +1,34 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class WebAudio : public BaseFingerprint {
+public:
+  friend Controller;
+  WebAudio(const WebAudio&) = delete;
+  WebAudio& operator=(const WebAudio&) = delete;
+
+private:
+  explicit WebAudio(const absl::optional<base::Value> &json_value);
+  ~WebAudio() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  BASE_EXPORT void ModifySampleRate(float &sample_rate);
+
+private:
+  struct SampleRate {
+    double m_seed{0};
+    double m_noise_min{0};
+    double m_noise_max{0};
+  } m_sample_rate;
+};
+
+} // namespace fingerprint
