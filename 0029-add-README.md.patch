+#include "product.h"
+#include "../interfaces/customer_interface.h"
+#include <iostream>
+#include <sstream>
+#include <iomanip>
+#include <random>
+
+Product::Product(const std::string& name, double price)
+    : name_(name), price_(price) {
+    // 生成随机ID
+    std::random_device rd;
+    std::mt19937 gen(rd());
+    std::uniform_int_distribution<> dis(10000, 99999);
+    id_ = "P" + std::to_string(dis(gen));
+}
+
+Product::~Product() = default;
+
+std::string Product::getId() const {
+    return id_;
+}
+
+std::string Product::getName() const {
+    return name_;
+}
+
+void Product::setName(const std::string& name) {
+    name_ = name;
+}
+
+std::string Product::serialize() const {
+    std::stringstream ss;
+    ss << id_ << "," << name_ << "," << std::fixed << std::setprecision(2) << price_;
+    return ss.str();
+}
+
+bool Product::deserialize(const std::string& data) {
+    std::stringstream ss(data);
+    std::string id, name;
+    double price;
+
+    std::getline(ss, id, ',');
+    std::getline(ss, name, ',');
+    ss >> price;
+
+    if (ss.fail()) {
+        return false;
+    }
+
+    id_ = id;
+    name_ = name;
+    price_ = price;
+    return true;
+}
+
+double Product::getPrice() const {
+    return price_;
+}
+
+void Product::setPrice(double price) {
+    price_ = price;
+}
+
+void Product::setCustomer(std::shared_ptr<ICustomer> customer) {
+    customer_ = customer;
+    std::cout << "产品 " << name_ << " 被分配给客户: " << customer->getName() << std::endl;
+}
+
+std::shared_ptr<ICustomer> Product::getCustomer() const {
+    return customer_;
+}
