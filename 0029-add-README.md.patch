diff --git a/advanced_example/app/main.cpp b/advanced_example/app/main.cpp
new file mode 100644
index 0000000000000..944ffefce1975
--- /dev/null
+++ b/advanced_example/app/main.cpp
@@ -0,0 +1,68 @@
+
+#include <iostream>
+#include <memory>
+#include <string>
+
+// 包含接口头文件
+#include "../interfaces/base_interfaces.h"
+#include "../interfaces/product_interface.h"
+#include "../interfaces/customer_interface.h"
+
+// 包含实现头文件
+#include "../product/product.h"
+#include "../product/product_factory.h"
+#include "../customer/customer.h"
+#include "../customer/customer_factory.h"
+
+int main() {
+    std::cout << "===== 高级接口层示例 =====" << std::endl << std::endl;
+
+    // 创建工厂
+    std::shared_ptr<IProductFactory> productFactory = std::make_shared<ProductFactory>();
+    std::shared_ptr<ICustomerFactory> customerFactory = std::make_shared<CustomerFactory>();
+
+    // 使用工厂创建对象
+    std::shared_ptr<ICustomer> customer1 = customerFactory->createCustomer("张三");
+    std::shared_ptr<ICustomer> customer2 = customerFactory->createCustomer("李四");
+
+    std::shared_ptr<IProduct> product1 = productFactory->createProduct("笔记本电脑", 5999.99);
+    std::shared_ptr<IProduct> product2 = productFactory->createProduct("智能手机", 3999.99);
+    std::shared_ptr<IProduct> product3 = productFactory->createProduct("耳机", 999.99);
+
+    std::cout << std::endl;
+
+    // 建立关系
+    product1->setCustomer(customer1);  // 产品关联客户
+    product2->setCustomer(customer1);
+    product3->setCustomer(customer2);
+
+    customer1->addProduct(product1);   // 客户购买产品
+    customer1->addProduct(product2);
+    customer2->addProduct(product3);
+
+    std::cout << std::endl;
+
+    // 显示结果
+    std::cout << "客户 " << customer1->getName() << " 的产品列表:" << std::endl;
+    double total1 = customer1->getTotalSpent();
+    std::cout << "  总价: ¥" << total1 << std::endl;
+
+    std::cout << std::endl;
+
+    std::cout << "客户 " << customer2->getName() << " 的产品列表:" << std::endl;
+    double total2 = customer2->getTotalSpent();
+    std::cout << "  总价: ¥" << total2 << std::endl;
+
+    std::cout << std::endl;
+    std::cout << "===== 依赖关系分析 =====" << std::endl;
+    std::cout << "Product 类 → 依赖 ICustomer 接口 (不依赖 Customer 类)" << std::endl;
+    std::cout << "Customer 类 → 依赖 IProduct 接口 (不依赖 Product 类)" << std::endl;
+    std::cout << "IProduct 接口 → 依赖 ISerializable, IIdentifiable, INamable 接口" << std::endl;
+    std::cout << "ICustomer 接口 → 依赖 ISerializable, IIdentifiable, INamable 接口" << std::endl;
+    std::cout << std::endl;
+    std::cout << "✓ 没有循环依赖！" << std::endl;
+
+    // customer_test();
+
+    return 0;
+}
