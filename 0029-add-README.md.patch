--- /dev/null
+++ b/advanced_example/customer/customer.cpp
@@ -0,0 +1,73 @@
+#include "customer.h"
+#include "../interfaces/product_interface.h"
+#include <iostream>
+#include <sstream>
+#include <random>
+
+Customer::Customer(const std::string& name) : name_(name) {
+    // 生成随机ID
+    std::random_device rd;
+    std::mt19937 gen(rd());
+    std::uniform_int_distribution<> dis(10000, 99999);
+    id_ = "C" + std::to_string(dis(gen));
+}
+
+Customer::~Customer() = default;
+
+std::string Customer::getId() const {
+    return id_;
+}
+
+std::string Customer::getName() const {
+    return name_;
+}
+
+void Customer::setName(const std::string& name) {
+    name_ = name;
+}
+
+std::string Customer::serialize() const {
+    std::stringstream ss;
+    ss << id_ << "," << name_ << "," << products_.size();
+    return ss.str();
+}
+
+bool Customer::deserialize(const std::string& data) {
+    std::stringstream ss(data);
+    std::string id, name;
+    size_t productCount;
+
+    std::getline(ss, id, ',');
+    std::getline(ss, name, ',');
+    ss >> productCount;
+
+    if (ss.fail()) {
+        return false;
+    }
+
+    id_ = id;
+    name_ = name;
+    return true;
+}
+
+void Customer::addProduct(std::shared_ptr<IProduct> product) {
+    products_.push_back(product);
+    std::cout << "客户 " << name_ << " 购买了产品: " << product->getName() << std::endl;
+}
+
+std::vector<std::shared_ptr<IProduct>> Customer::getProducts() const {
+    return products_;
+}
+
+double Customer::getTotalSpent() const {
+    double total = 0.0;
+    for (const auto& product : products_) {
+        std::cout << "  - " << product->getName() << ": ¥" << product->getPrice() << std::endl;
+        total += product->getPrice();
+    }
+    return total;
+}
+
+void customer_test() {
+    std::cout << "--------------------------------------" << std::endl;
+}
