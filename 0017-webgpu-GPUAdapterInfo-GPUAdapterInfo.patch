index 25e6e80ae313f..db2aa2e78f0da 100644
--- a/a_tools/fingerprint/controller.cc
+++ b/a_tools/fingerprint/controller.cc
@@ -30,6 +30,7 @@ Controller::Controller()
     ParseJson();
     ParseWebGL();
     ParseFonts();
+    ParseWebGPU();
   }
 }
 
@@ -110,8 +111,8 @@ bool Controller::ParseWebGL() {
       base::DictValue* webgl_extensions_dict = webgl_dict->FindDict("extensions");
       if (webgl_extensions_dict) {
         std::optional<bool> webgl_extensions_random_shuffle = webgl_extensions_dict->FindBool("random_shuffle");
-        if (webgl_extensions_random_shuffle.has_value() && webgl_extensions_random_shuffle.value()) {
-          m_webgl_extensions_random_shuffle = webgl_extensions_random_shuffle.value();
+        if (webgl_extensions_random_shuffle.has_value()) {
+          m_webgl_extensions_random_shuffle_enable = webgl_extensions_random_shuffle.value();
         }
       }
       base::DictValue* webgl_pixels_dict = webgl_dict->FindDict("pixels");
@@ -162,4 +163,43 @@ bool Controller::ParseFonts() {
   return false;
 }
 
+bool Controller::ParseWebGPU() {
+  base::DictValue* webgpu_dict = m_json_value->GetDict().FindDict("webgpu");
+  if (webgpu_dict) {
+    std::optional<bool> webgpu_enable = webgpu_dict->FindBool("enable");
+    if (webgpu_enable.has_value() && webgpu_enable.value()) {
+      m_webgpu_enable = webgpu_enable.value();
+      base::DictValue* webgpu_params_dict = webgpu_dict->FindDict("params");
+      if (webgpu_params_dict) {
+        base::DictValue* webgpu_params_info_dict = webgpu_params_dict->FindDict("info");
+        if (webgpu_params_info_dict) {
+          std::string* webgpu_vendor = webgpu_params_info_dict->FindString("vendor");
+          if (webgpu_vendor) {
+            m_webgpu_vendor = *webgpu_vendor;
+          }
+          std::string* webgpu_architecture = webgpu_params_info_dict->FindString("architecture");
+          if (webgpu_architecture) {
+            m_webgpu_architecture = *webgpu_architecture;
+          }
+          std::string* webgpu_device = webgpu_params_info_dict->FindString("device");
+          if (webgpu_device) {
+            m_webgpu_device = *webgpu_device;
+          }
+          std::string* webgpu_description = webgpu_params_info_dict->FindString("description");
+          if (webgpu_description) {
+            m_webgpu_description = *webgpu_description;
+          }
+          std::optional<bool> webgpu_is_fallback_adapter = webgpu_params_info_dict->FindBool("is_fallback_adapter");
+          if (webgpu_is_fallback_adapter.has_value()) {
+            m_webgpu_is_fallback_adapter_initialized = true;
+            m_webgpu_is_fallback_adapter = webgpu_is_fallback_adapter.value();
+          }
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
 } // namespace fingerprint
