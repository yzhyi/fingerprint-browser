diff --git a/a_tools/fingerprint/controller.cc b/a_tools/fingerprint/controller.cc
index 1e9ad30b43c50..11e0dd2d3c528 100644
--- a/a_tools/fingerprint/controller.cc
+++ b/a_tools/fingerprint/controller.cc
@@ -1,8 +1,36 @@
+#include <iostream>
 #include "a_tools/fingerprint/controller.h"
+#include "content/public/common/content_switches.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+#include "third_party/libc++/src/include/__filesystem/path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
 
 namespace fingerprint {
 
-void Controller::show() {
-  std::cout << "show" << std::endl;
+Controller::Controller()
+  : m_command_line(base::CommandLine::ForCurrentProcess()) {
+  if (m_command_line->HasSwitch(switches::kYzhyi)) {
+    m_json_str = m_command_line->
+      GetSwitchValueASCII(switches::kYzhyi);
+  }
 }
+
+Controller::~Controller() {}
+
+bool Controller::AppendCommandLine(base::CommandLine* command_line) {
+  if (!m_json_str.empty()) {
+    command_line->AppendSwitchASCII(switches::kYzhyi, m_json_str);
+    return true;
+  }
+  return false;
+}
+
+void Controller::PrintJson() {
+  std::cout << m_json_str << std::endl;
+  LOG(INFO) << "---------------hello-------------------";
+}
+
 }
