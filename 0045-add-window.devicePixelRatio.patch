-    return fingerprint::Controller::GetInstance().GetWindow().GetScreenWidth();
+  if (auto& window = fingerprint::Controller::GetInstance().GetWindow(); window.Enabled()) {
+    return window.GetScreenWidth();
   }
   #endif // ENABLE_FINGERPRINT
 
@@ -160,8 +160,8 @@ unsigned Screen::colorDepth() const {
   }
 
   #ifdef ENABLE_FINGERPRINT
-  if (fingerprint::Controller::GetInstance().GetWindow().Enabled()) {
-    return fingerprint::Controller::GetInstance().GetWindow().GetScreenColorDepth();
+  if (auto& window = fingerprint::Controller::GetInstance().GetWindow(); window.Enabled()) {
+    return window.GetScreenColorDepth();
   }
   #endif // ENABLE_FINGERPRINT
 
@@ -173,8 +173,8 @@ unsigned Screen::colorDepth() const {
 unsigned Screen::pixelDepth() const {
 
   #ifdef ENABLE_FINGERPRINT
-  if (fingerprint::Controller::GetInstance().GetWindow().Enabled()) {
-    return fingerprint::Controller::GetInstance().GetWindow().GetScreenPixelDepth();
+  if (auto& window = fingerprint::Controller::GetInstance().GetWindow(); window.Enabled()) {
+    return window.GetScreenPixelDepth();
   }
   #endif // ENABLE_FINGERPRINT
 
@@ -190,8 +190,8 @@ int Screen::availLeft() const {
   }
 
   #ifdef ENABLE_FINGERPRINT
-  if (fingerprint::Controller::GetInstance().GetWindow().Enabled()) {
-    return fingerprint::Controller::GetInstance().GetWindow().GetScreenAvailLeft();
+  if (auto& window = fingerprint::Controller::GetInstance().GetWindow(); window.Enabled()) {
+    return window.GetScreenAvailLeft();
   }
   #endif // ENABLE_FINGERPRINT
 
@@ -207,8 +207,8 @@ int Screen::availTop() const {
   }
 
   #ifdef ENABLE_FINGERPRINT
-  if (fingerprint::Controller::GetInstance().GetWindow().Enabled()) {
-    return fingerprint::Controller::GetInstance().GetWindow().GetScreenAvailTop();
+  if (auto& window = fingerprint::Controller::GetInstance().GetWindow(); window.Enabled()) {
+    return window.GetScreenAvailTop();
   }
   #endif // ENABLE_FINGERPRINT
 
@@ -224,8 +224,8 @@ int Screen::availHeight() const {
   }
 
   #ifdef ENABLE_FINGERPRINT
-  if (fingerprint::Controller::GetInstance().GetWindow().Enabled()) {
-    return fingerprint::Controller::GetInstance().GetWindow().GetScreenAvailHeight();
+  if (auto& window = fingerprint::Controller::GetInstance().GetWindow(); window.Enabled()) {
+    return window.GetScreenAvailHeight();
   }
   #endif // ENABLE_FINGERPRINT
 
@@ -241,8 +241,8 @@ int Screen::availWidth() const {
   }
 
   #ifdef ENABLE_FINGERPRINT
-  if (fingerprint::Controller::GetInstance().GetWindow().Enabled()) {
-    return fingerprint::Controller::GetInstance().GetWindow().GetScreenAvailWidth();
+  if (auto& window = fingerprint::Controller::GetInstance().GetWindow(); window.Enabled()) {
+    return window.GetScreenAvailWidth();
   }
   #endif // ENABLE_FINGERPRINT
 
