index 7e5854229a2dd..0616fd7c078ce 100644
--- a/third_party/blink/renderer/core/frame/screen.cc
+++ b/third_party/blink/renderer/core/frame/screen.cc
@@ -123,8 +123,8 @@ int Screen::height() const {
   }
 
   #ifdef ENABLE_FINGERPRINT
