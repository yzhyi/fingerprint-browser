diff --git a/a_tools/fingerprint/device_memory/device_memory.cc b/a_tools/fingerprint/device_memory/device_memory.cc
index fd599d9522d41..5b505c5419af0 100644
--- a/a_tools/fingerprint/device_memory/device_memory.cc
+++ b/a_tools/fingerprint/device_memory/device_memory.cc
@@ -15,7 +15,7 @@ bool DeviceMemory::ParseJson(const absl::optional<base::Value> &json_value) {
   if (const base::DictValue* dict = FindDict(json_value.value(), "device_memory"); dict) {
     if (FindBool(dict, "enabled", m_enabled); m_enabled) {
       if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
-        FindDouble(params_dict, "gb", m_gb);
+        FindDouble(params_dict, "MiB", m_MiB);
       }
     }
     return true;
@@ -23,10 +23,11 @@ bool DeviceMemory::ParseJson(const absl::optional<base::Value> &json_value) {
   return false;
 }
 
-void DeviceMemory::ModifyDeviceMemory(float &gb) {
+uint64_t DeviceMemory::GetDeviceMemory() {
   if (m_enabled) {
-    gb = m_gb;
+    return m_MiB * 1024 * 1024;
   }
+  return -1;
 }
 
 } // namespace fingerprint
diff --git a/a_tools/fingerprint/device_memory/device_memory.h b/a_tools/fingerprint/device_memory/device_memory.h
index 671292ca8d015..c3986df64b892 100644
--- a/a_tools/fingerprint/device_memory/device_memory.h
+++ b/a_tools/fingerprint/device_memory/device_memory.h
@@ -20,10 +20,10 @@ private:
 
 public:
   bool ParseJson(const absl::optional<base::Value> &json_value) override;
-  void ModifyDeviceMemory(float &gb);
+  uint64_t GetDeviceMemory();
 
 private:
-  double m_gb{0};
+  double m_MiB{0};
 };
 
 } // namespace fingerprint
diff --git a/base/system/sys_info_linux.cc b/base/system/sys_info_linux.cc
index de42105dc4197..6dd6f21d2a19a 100644
--- a/base/system/sys_info_linux.cc
+++ b/base/system/sys_info_linux.cc
@@ -36,6 +36,7 @@ uint64_t AmountOfMemory(int pages_name) {
   if (pages < 0 || page_size < 0) {
     return 0;
   }
+  // TODO: Yzhyi
   return static_cast<uint64_t>(pages) * static_cast<uint64_t>(page_size);
 }
 
