diff --git a/a_tools/fingerprint/utils/parse_json.cc b/a_tools/fingerprint/utils/parse_json.cc
new file mode 100644
index 0000000000000..f9be158e2397b
--- /dev/null
+++ b/a_tools/fingerprint/utils/parse_json.cc
@@ -0,0 +1,40 @@
+#include "parse_json.h"
+
+namespace fingerprint {
+
+const base::DictValue* FindDict(const base::Value &json_value, std::string_view key) {
+  return json_value.GetDict().FindDict(key);
+}
+
+const base::DictValue* FindDict(const base::DictValue *json_dict, std::string_view key) {
+  return json_dict->FindDict(key);
+}
+
+bool FindBool(const base::DictValue *json_dict, std::string_view key, bool &value) {
+  std::optional<bool> key_value = json_dict->FindBool(key);
+  if (key_value.has_value()) {
+    value = key_value.value();
+    return true;
+  }
+  return false;
+}
+
+bool FindDouble(const base::DictValue *json_dict, std::string_view key, double &value) {
+  std::optional<double> key_value = json_dict->FindDouble(key);
+  if (key_value.has_value()) {
+    value = key_value.value();
+    return true;
+  }
+  return false;
+}
+
+bool FindString(const base::DictValue *json_dict, std::string_view key, std::string &value) {
+  const std::string* key_value = json_dict->FindString(key);
+  if (key_value) {
+    value = *key_value;
+    return true;
+  }
+  return false;
+}
+
+} // namespace fingerprint
