diff --git a/a_tools/fingerprint/user_agent/user_agent.cc b/a_tools/fingerprint/user_agent/user_agent.cc
new file mode 100644
index 0000000000000..90af0d278885f
--- /dev/null
+++ b/a_tools/fingerprint/user_agent/user_agent.cc
@@ -0,0 +1,34 @@
+#include "./user_agent.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+UserAgent::UserAgent(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+UserAgent::~UserAgent() = default;
+
+bool UserAgent::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "user_agent"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindString(params_dict, "user_agent", m_user_agent);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+std::string UserAgent::GetCommandLineKey() {
+  return "user-agent";
+}
+
+std::string UserAgent::GetUserAgent() {
+  return m_user_agent;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/user_agent/user_agent.h b/a_tools/fingerprint/user_agent/user_agent.h
new file mode 100644
index 0000000000000..3c728c3971bc8
--- /dev/null
+++ b/a_tools/fingerprint/user_agent/user_agent.h
@@ -0,0 +1,21 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+FINGERPRINT_CLASS_DECLARE(UserAgent);
+
+public:
+  std::string GetCommandLineKey();
+  std::string GetUserAgent();
+
+private:
+  std::string m_user_agent;
+
+FINGERPRINT_CLASS_END();
+
+} // namespace fingerprint
