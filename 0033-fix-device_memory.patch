 #include "a_tools/fingerprint/utils/random.h"
 #include "a_tools/fingerprint/utils/parse_json.h"
+#include <cstdint>
+#include <iostream>
 
 namespace fingerprint {
 
@@ -15,7 +17,7 @@ bool DeviceMemory::ParseJson(const absl::optional<base::Value> &json_value) {
   if (const base::DictValue* dict = FindDict(json_value.value(), "device_memory"); dict) {
     if (FindBool(dict, "enabled", m_enabled); m_enabled) {
       if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
-        FindDouble(params_dict, "MiB", m_MiB);
+        FindDouble(params_dict, "GiB", m_GiB);
       }
     }
     return true;
@@ -23,11 +25,10 @@ bool DeviceMemory::ParseJson(const absl::optional<base::Value> &json_value) {
   return false;
 }
 
-uint64_t DeviceMemory::GetDeviceMemory() {
+void DeviceMemory::ModifyDeviceMemory(float &GiB) {
   if (m_enabled) {
-    return m_MiB * 1024 * 1024;
+    GiB = m_GiB;
   }
-  return -1;
 }
 
 } // namespace fingerprint
