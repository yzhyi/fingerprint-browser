diff --git a/a_tools/fingerprint/navigator/navigator.cc b/a_tools/fingerprint/navigator/navigator.cc
new file mode 100644
index 0000000000000..f6ba428f60419
--- /dev/null
+++ b/a_tools/fingerprint/navigator/navigator.cc
@@ -0,0 +1,33 @@
+#include "./navigator.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+Navigator::Navigator(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+Navigator::~Navigator() = default;
+
+bool Navigator::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "hardware_concurrency"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindDouble(params_dict, "cores", m_cores);
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+unsigned Navigator::ModifyHardwareConcurrency(unsigned cores) {
+  if (m_enabled) {
+    return m_cores;
+  }
+  return cores;
+}
+
+} // namespace fingerprint
