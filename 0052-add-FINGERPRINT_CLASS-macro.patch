@@ -23,4 +23,20 @@ protected:
   bool m_enabled{false};
 };
 
+// 宏定义：简化 BaseFingerprint 派生类的定义
+#define FINGERPRINT_CLASS_DECLARE(ClassName) \
+  class Controller; \
+  class ClassName : public BaseFingerprint { \
+  public: \
+    friend Controller; \
+    ClassName(const ClassName&) = delete; \
+    ClassName& operator=(const ClassName&) = delete; \
+  private: \
+    explicit ClassName(const absl::optional<base::Value> &json_value); \
+    ~ClassName() override; \
+    bool ParseJson(const absl::optional<base::Value> &json_value) override
+
+#define FINGERPRINT_CLASS_END() \
+  }
+
 } // namespace fingerprint
