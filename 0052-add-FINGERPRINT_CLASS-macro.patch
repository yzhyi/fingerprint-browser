+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+FINGERPRINT_CLASS_DECLARE(Navigator);
+
+public:
+  BASE_EXPORT unsigned ModifyHardwareConcurrency(unsigned cores);
+
+private:
+  double m_cores{0};
+
+FINGERPRINT_CLASS_END();
+
+} // namespace fingerprint
