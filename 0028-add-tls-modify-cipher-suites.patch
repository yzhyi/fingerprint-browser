diff --git a/a_tools/fingerprint/tls/tls.cc b/a_tools/fingerprint/tls/tls.cc
new file mode 100644
index 0000000000000..8961373077e88
--- /dev/null
+++ b/a_tools/fingerprint/tls/tls.cc
@@ -0,0 +1,48 @@
+#include "tls.h"
+#include "a_tools/fingerprint/utils/parse_json.h"
+#include <iostream>
+
+namespace fingerprint {
+
+TLS::TLS(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+TLS::~TLS() = default;
+
+bool TLS::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "tls"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        if (const base::DictValue* cipher_suit_dict = FindDict(params_dict, "cipher_suites"); cipher_suit_dict) {
+          if (const base::ListValue* add_list = FindList(cipher_suit_dict, "add"); add_list) {
+            for (auto& value : *add_list) {
+              m_adds.push_back(":+" + value.GetString());
+            }
+          }
+          if (const base::ListValue* sub_list = FindList(cipher_suit_dict, "sub"); sub_list) {
+            for (auto& value : *sub_list) {
+              m_subs.push_back(":-" + value.GetString());
+            }
+          }
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+void TLS::ModifyCipherSuites(std::string &command) {
+  if (m_enabled) {
+    for (auto s : m_adds) {
+      command.append(s);
+    }
+    for (auto s : m_subs) {
+      command.append(s);
+    }
+  }
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/tls/tls.h b/a_tools/fingerprint/tls/tls.h
new file mode 100644
index 0000000000000..84b7a0690c8f4
--- /dev/null
+++ b/a_tools/fingerprint/tls/tls.h
@@ -0,0 +1,30 @@
+# pragma once
+
+#include "a_tools/fingerprint/base_fingerprint.h"
+#include "base/values.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+class Controller;
+
+class TLS : public BaseFingerprint {
+public:
+  friend Controller;
+  TLS(const TLS&) = delete;
+  TLS& operator=(const TLS&) = delete;
+
+private:
+  explicit TLS(const absl::optional<base::Value> &json_value);
+  ~TLS() override;
+
+public:
+  bool ParseJson(const absl::optional<base::Value> &json_value) override;
+  void ModifyCipherSuites(std::string &command);
+
+private:
+  std::vector<std::string> m_adds;
+  std::vector<std::string> m_subs;
+};
+
+} // namespace fingerprint
