---
 a_tools/fingerprint/controller.cc | 8 ++++----
 a_tools/fingerprint/controller.h  | 2 +-
 base/command_line.cc              | 4 ++--
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/a_tools/fingerprint/controller.cc b/a_tools/fingerprint/controller.cc
index ad7ff417e4014..25e6e80ae313f 100644
--- a/a_tools/fingerprint/controller.cc
+++ b/a_tools/fingerprint/controller.cc
@@ -8,7 +8,7 @@
 
 namespace fingerprint {
 
-const char kYzhyi[] = "yzhyi";
+const char kFingerprint[] = "fp";
 
 int Controller::RandomInt(int min, int max) {
   if (min > max) {
@@ -23,9 +23,9 @@ int Controller::RandomInt(int min, int max) {
 
 Controller::Controller()
   : m_command_line(base::CommandLine::ForCurrentProcess()) {
-  if (m_command_line->HasSwitch(kYzhyi)) {
+  if (m_command_line->HasSwitch(kFingerprint)) {
     m_json_str = m_command_line->
-      GetSwitchValueASCII(kYzhyi);
+      GetSwitchValueASCII(kFingerprint);
     m_json_value = base::JSONReader::Read(m_json_str);
     ParseJson();
     ParseWebGL();
@@ -37,7 +37,7 @@ Controller::~Controller() {}
 
 bool Controller::AppendCommandLine(base::CommandLine* command_line) {
   if (!m_json_str.empty()) {
-    command_line->AppendSwitchASCII(kYzhyi, m_json_str);
+    command_line->AppendSwitchASCII(kFingerprint, m_json_str);
     return true;
   }
   return false;
diff --git a/a_tools/fingerprint/controller.h b/a_tools/fingerprint/controller.h
