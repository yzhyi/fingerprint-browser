 class Controller {
 public:
diff --git a/base/command_line.cc b/base/command_line.cc
index 83e9fbe0cb5fc..7088ddd6b9998 100644
--- a/base/command_line.cc
+++ b/base/command_line.cc
@@ -669,8 +669,8 @@ void CommandLine::AppendSwitchesAndArguments(span<const StringType> argv) {
     parse_switches &= (arg != kSwitchTerminator);
     if (parse_switches && IsSwitch(arg, &switch_string, &switch_value)) {
       // Yzhyi start
-      const char kYzhyi[] = "--yzhyi";
-      if (switch_string == CommandLine::StringType(kYzhyi)) {
+      const char kFingerprint[] = "--fp";
+      if (switch_string == CommandLine::StringType(kFingerprint)) {
         if (IsJsonFile(switch_value)) {
           ::base::FilePath path(switch_value);
           std::string temp_str;
