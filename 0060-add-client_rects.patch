diff --git a/a_tools/fingerprint/client_rects/client_rects.cc b/a_tools/fingerprint/client_rects/client_rects.cc
new file mode 100644
index 0000000000000..a02e1fb5c1898
--- /dev/null
+++ b/a_tools/fingerprint/client_rects/client_rects.cc
@@ -0,0 +1,41 @@
+#include "./client_rects.h"
+#include "../utils/random.h"
+#include "../utils/parse_json.h"
+
+namespace fingerprint {
+
+ClientRects::ClientRects(const absl::optional<base::Value> &json_value) {
+  ParseJson(json_value);
+}
+
+ClientRects::~ClientRects() = default;
+
+bool ClientRects::ParseJson(const absl::optional<base::Value> &json_value) {
+  if (!json_value) return false;
+  if (const base::DictValue* dict = FindDict(json_value.value(), "client_rects"); dict) {
+    if (FindBool(dict, "enabled", m_enabled); m_enabled) {
+      if (const base::DictValue* params_dict = FindDict(dict, "params"); params_dict) {
+        FindDouble(params_dict, "seed", m_seed);
+        FindDouble(params_dict, "noise_min", m_noise_min);
+        FindDouble(params_dict, "noise_max", m_noise_max);
+        FindDouble(params_dict, "noise_level", m_noise_level);
+
+        static Random rand(m_noise_min, m_noise_max, m_seed);
+        m_width_noise = rand.NextDouble() * m_noise_level;
+        m_height_noise = rand.NextDouble() * m_noise_level;
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+double ClientRects::GetWidthNoise() {
+  return m_width_noise;
+}
+
+double ClientRects::GetHeightNoise() {
+  return m_height_noise;
+}
+
+} // namespace fingerprint
diff --git a/a_tools/fingerprint/client_rects/client_rects.h b/a_tools/fingerprint/client_rects/client_rects.h
new file mode 100644
index 0000000000000..914b527f14ac9
--- /dev/null
+++ b/a_tools/fingerprint/client_rects/client_rects.h
@@ -0,0 +1,27 @@
+# pragma once
+
+#include "../base_fingerprint.h"
+#include "base/values.h"
+#include "base/base_export.h"
+#include "third_party/abseil-cpp/absl/types/optional.h"
+
+namespace fingerprint {
+
+FINGERPRINT_CLASS_DECLARE(ClientRects);
+
+public:
+  BASE_EXPORT double GetWidthNoise();
+  BASE_EXPORT double GetHeightNoise();
+
+private:
+  double m_seed{0};
+  double m_noise_min{0};
+  double m_noise_max{0};
+  double m_noise_level{1};
+  
+  double m_width_noise{0};
+  double m_height_noise{0};
+
+FINGERPRINT_CLASS_END();
+
+} // namespace fingerprint
