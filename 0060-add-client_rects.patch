 #include "third_party/blink/renderer/core/geometry/dom_rect.h"
 
 #include "third_party/blink/renderer/bindings/core/v8/v8_dom_rect_init.h"
@@ -13,15 +17,55 @@
 namespace blink {
 
 DOMRect* DOMRect::Create(double x, double y, double width, double height) {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &client_rects = fingerprint::Controller::GetInstance().GetClientRects(); client_rects.Enabled()) {
+    double new_width = width;
+    double new_height = height;
+    if (x > 0 && y > 0){
+      new_width += client_rects.GetWidthNoise();
+      new_height += client_rects.GetHeightNoise();
+    }
+    return MakeGarbageCollected<DOMRect>(x, y, new_width, new_height);
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return MakeGarbageCollected<DOMRect>(x, y, width, height);
 }
 
 DOMRect* DOMRect::FromRectF(const gfx::RectF& rect) {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &client_rects = fingerprint::Controller::GetInstance().GetClientRects(); client_rects.Enabled()) {
+    float new_width = rect.width();
+    float new_height = rect.height();
+    if (rect.x() > 0 && rect.y() > 0){
+      new_width += client_rects.GetWidthNoise();
+      new_height += client_rects.GetHeightNoise();
+    }
+    return MakeGarbageCollected<DOMRect>(rect.x(), rect.y(), new_width, new_height);
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return MakeGarbageCollected<DOMRect>(rect.x(), rect.y(), rect.width(),
                                        rect.height());
 }
 
 DOMRect* DOMRect::fromRect(const DOMRectInit* other) {
+
+  #ifdef ENABLE_FINGERPRINT
+  if (auto &client_rects = fingerprint::Controller::GetInstance().GetClientRects(); client_rects.Enabled()) {
+    double new_width = other->width();
+    double new_height = other->height();
+    if (other->x() > 0 && other->y() > 0){
+      new_width += client_rects.GetWidthNoise();
+      new_height += client_rects.GetHeightNoise();
+    }
+    return MakeGarbageCollected<DOMRect>(other->x(), other->y(), new_width,
+                                        new_height);
+  }
+  #endif // ENABLE_FINGERPRINT
+
   return MakeGarbageCollected<DOMRect>(other->x(), other->y(), other->width(),
                                        other->height());
 }
