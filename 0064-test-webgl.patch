@@ -4824,7 +4824,8 @@ ScriptValue WebGL2RenderingContextBase::getParameter(ScriptState* script_state,
     case GL_MAX_ARRAY_TEXTURE_LAYERS:
       return GetIntParameter(script_state, pname);
     case GC3D_MAX_CLIENT_WAIT_TIMEOUT_WEBGL:
-      return WebGLAny(script_state, kMaxClientWaitTimeout);
+      // return WebGLAny(script_state, kMaxClientWaitTimeout);
+      return WebGLAny(script_state, 0);
     case GL_MAX_COLOR_ATTACHMENTS:
       return GetIntParameter(script_state, pname);
     case GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS:
@@ -5017,6 +5018,22 @@ ScriptValue WebGL2RenderingContextBase::GetInt64Parameter(
   GLint64 value = 0;
   if (!isContextLost())
     ContextGL()->GetInteger64v(pname, &value);
+  if (pname == GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS) {
+    return WebGLAny(script_state, 200704);
+  }
+  if (pname == GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS) {
+    return WebGLAny(script_state, 212988);
+  }
+  if (pname == GL_MAX_ELEMENT_INDEX) {
+    return WebGLAny(script_state, 4294967294);
+  }
+  if (pname == GL_MAX_SERVER_WAIT_TIMEOUT) {
+    return WebGLAny(script_state, 0);
+  }
+  if (pname == GL_MAX_UNIFORM_BLOCK_SIZE) {
+    return WebGLAny(script_state, 65536);
+  }
+
   return WebGLAny(script_state, value);
 }
 
